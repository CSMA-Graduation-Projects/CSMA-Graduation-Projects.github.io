<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-research-collaboration" name="From first contact to research collaboration"><mxGraphModel dx="920" dy="2776" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2776" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="From first contact to research collaboration" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="Six practical steps connect your interests with an agreed research or competition project. Two shared decisions keep the work&#10;suitable for both sides." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="52" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="132" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: This is an invitation to discuss collaboration, not a promise of a place, funding or admission. Timing and&#10;arrangements are agreed individually; pausing or concluding is a valid outcome. Formal procedures apply only where relevant." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2666" width="840" height="50" as="geometry" /></mxCell><object id="interest" label="Choose a question to explore&#10;&#10;Use the published research directions to describe your&#10;interests and learning goals." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#directions" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="222" width="408" height="150" as="geometry" /></mxCell></object><object id="contact" label="Send a short introduction&#10;&#10;Describe your background, shareable work, availability,&#10;participation mode and language." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#contact" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="487" width="408" height="150" as="geometry" /></mxCell></object><object id="discussion" label="Discuss interests and expectations&#10;&#10;Discuss goals, preparation, supervision, resources and&#10;available time." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#fit" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="752" width="408" height="150" as="geometry" /></mxCell></object><object id="ready" label="Can we agree on a suitable&#10;first task?&#10;&#10;Both sides understand the task and&#10;feedback arrangements, and its&#10;conditions can be met." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#fit" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1017" width="408" height="286" as="geometry" /></mxCell></object><object id="adjust" label="Adjust the direction, timing or&#10;preparation&#10;&#10;Narrow the task or build foundations;&#10;either side may close the discussion and&#10;reconnect later." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#fit" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1017" width="310" height="184" as="geometry" /></mxCell></object><object id="task" label="Complete the agreed small task&#10;&#10;Produce an explainable result, an honest work record&#10;and questions against the learning goal." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#first-task" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1418" width="408" height="150" as="geometry" /></mxCell></object><object id="feedback" label="Review the work together&#10;&#10;Discuss the result, difficulties, individual contribution and&#10;support needed." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#first-task" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1683" width="408" height="150" as="geometry" /></mxCell></object><object id="continue" label="Do both sides want and have&#10;the capacity to continue?&#10;&#10;Confirm research fit, supervision&#10;capacity, task conditions and&#10;individual commitments." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#next" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1948" width="408" height="312" as="geometry" /></mxCell></object><object id="replan" label="Revise the plan or conclude&#10;the collaboration&#10;&#10;Record feedback and contributions;&#10;discuss a revised plan or finish with a&#10;useful summary." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#next" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1948" width="310" height="184" as="geometry" /></mxCell></object><object id="collaborate" label="Confirm collaboration and continue&#10;learning&#10;&#10;Agree on tasks and supervision; use the joint training&#10;guide when visiting, credit or degree procedures apply." link="https://csma-graduation-projects.github.io/en/research-collaboration.html#next" tooltip="Completion and next steps"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2375" width="408" height="164" as="geometry" /></mxCell></object><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="interest" target="contact"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="contact" target="discussion"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="discussion" target="ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="When both sides agree" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="ready" target="task"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="Not a fit yet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="ready" target="adjust"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="If continuing, return to discussion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="adjust" target="discussion"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="874" y="1109.0" /><mxPoint x="874" y="732" /><mxPoint x="422" y="732" /></Array><mxPoint x="-155.0" y="116.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="task" target="feedback"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="feedback" target="continue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="When both sides confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="continue" target="collaborate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="Revise or conclude" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="continue" target="replan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="If trying again, discuss anew" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="replan" target="discussion"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="874" y="2040.0" /><mxPoint x="874" y="732" /><mxPoint x="422" y="732" /></Array><mxPoint x="-155.0" y="116.5" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
