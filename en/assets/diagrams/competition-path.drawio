<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-competition-path" name="Competitions and innovation workflow"><mxGraphModel dx="920" dy="3135" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="3135" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Competitions and innovation workflow" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="The main route covers all 6 stages. Decision nodes state when to continue; side branches show where to return if conditions&#10;are not met." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="52" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="132" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: Plan registration independently around the official window. Registration and prototyping may overlap or&#10;occur in a different order under the rules; do not miss a deadline while awaiting an internal milestone. Each restricted activity&#10;still requires its formal prerequisites. This diagram guides the work; official decisions determine eligibility and results." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="3004" width="840" height="71" as="geometry" /></mxCell><object id="selection" label="Competition, eligibility and rules&#10;&#10;Check the track, eligibility, current rules and official&#10;deadlines." link="https://csma-graduation-projects.github.io/en/competition.html#selection" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="222" width="408" height="150" as="geometry" /></mxCell></object><object id="selection-check" label="Are eligibility and rules&#10;confirmed?&#10;&#10;Use the current official notice, not&#10;assumptions from previous editions." link="https://csma-graduation-projects.github.io/en/competition.html#selection" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="487" width="408" height="240" as="geometry" /></mxCell></object><object id="selection-revise" label="Revise and review&#10;&#10;Change track or stop if ineligible. Ask&#10;the organizer about unclear rules before&#10;committing resources." link="https://csma-graduation-projects.github.io/en/templates.html#competition" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="487" width="310" height="180" as="geometry" /></mxCell></object><object id="team" label="Team, topic and ownership agreement&#10;&#10;Agree on roles, project scope and ownership of&#10;materials and outputs." link="https://csma-graduation-projects.github.io/en/competition.html#team" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="842" width="408" height="150" as="geometry" /></mxCell></object><object id="prototype" label="Prototype, budget and registration&#10;&#10;Track registration separately; develop the prototype and&#10;budget against the event schedule." link="https://csma-graduation-projects.github.io/en/competition.html#prototype" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1107" width="408" height="150" as="geometry" /></mxCell></object><object id="prototype-check" label="Current work prerequisites&#10;and registration plan clear?&#10;&#10;Meet eligibility and budget conditions&#10;for the current activity; continue&#10;tracking registration status." link="https://csma-graduation-projects.github.io/en/competition.html#prototype" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1372" width="408" height="292" as="geometry" /></mxCell></object><object id="prototype-revise" label="Revise and review&#10;&#10;Revise the approach, correct&#10;registration or reduce the budget. Stop&#10;and record the reason if unresolved." link="https://csma-graduation-projects.github.io/en/templates.html#competition" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1372" width="310" height="180" as="geometry" /></mxCell></object><object id="build" label="Implementation, replication and internal&#10;acceptance&#10;&#10;Check the project against scoring criteria, versions and&#10;licenses." link="https://csma-graduation-projects.github.io/en/competition.html#build" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1779" width="408" height="164" as="geometry" /></mxCell></object><object id="build-check" label="Does the project meet&#10;submission conditions?&#10;&#10;Match scoring criteria, permissions,&#10;functionality and material versions&#10;item by item." link="https://csma-graduation-projects.github.io/en/competition.html#build" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2058" width="408" height="261" as="geometry" /></mxCell></object><object id="build-revise" label="Revise and review&#10;&#10;Fix defects or remove unreliable&#10;features. Replace noncompliant&#10;components, then repeat acceptance&#10;checks." link="https://csma-graduation-projects.github.io/en/templates.html#experiment" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="2058" width="310" height="180" as="geometry" /></mxCell></object><object id="submission" label="Submission, competition and confirmed&#10;results&#10;&#10;Keep submission receipts. Record awards only from&#10;official results." link="https://csma-graduation-projects.github.io/en/competition.html#submission" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2434" width="408" height="164" as="geometry" /></mxCell></object><object id="archive" label="Reflection, expense settlement and&#10;archiving&#10;&#10;Complete the review, settle expenses and equipment,&#10;and archive authorized materials." link="https://csma-graduation-projects.github.io/en/competition.html#archive" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2713" width="408" height="164" as="geometry" /></mxCell></object><mxCell id="edge-0" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="selection-check" target="selection-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="Return to rules and eligibility" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="selection-revise" target="selection"><mxGeometry relative="1"