<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-doctor-path" name="Doctoral research and degree pathway"><mxGraphModel dx="920" dy="5607" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="5607" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Doctoral research and degree pathway" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="11 stages connect the research agenda, original contributions and formal degree milestones, with routes for revision and&#10;further evidence." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="52" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="132" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: Complete qualification only where required by your programme. Follow institutional rules for its order relative&#10;to the proposal, any pre-defense and thesis review. Annual and interim reviews recur throughout research; their position here&#10;is for navigation. Research, literature review and writing iterate, and outcome requirements are checked from entry. Passing&#10;the defense does not itself confer the degree." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="5455" width="840" height="92" as="geometry" /></mxCell><object id="orientation" label="Programme Requirements, Supervision and&#10;Development Plan&#10;&#10;Confirm applicable rules, outcome criteria, language&#10;and supervision arrangements." link="https://csma-graduation-projects.github.io/en/doctor.html#orientation" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="222" width="408" height="164" as="geometry" /></mxCell></object><object id="foundation" label="Foundations, Research Methods and a Map&#10;of Questions&#10;&#10;Build a literature comparison, problem map and&#10;feasibility evidence." link="https://csma-graduation-projects.github.io/en/doctor.html#foundation" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="501" width="408" height="164" as="geometry" /></mxCell></object><object id="qualification" label="Qualifying Assessment and Research&#10;Readiness, Where Applicable&#10;&#10;Confirm whether qualification applies, its order and&#10;format, then complete the required assessment." link="https://csma-graduation-projects.github.io/en/doctor.html#qualification" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="780" width="408" height="164" as="geometry" /></mxCell></object><object id="qualification-check" label="Requirements due at this&#10;point confirmed and met?&#10;&#10;Use your programme sequence:&#10;record a later qualification milestone if&#10;scheduled after the proposal, or the&#10;basis if it does not apply. Uncertainty&#10;is not an exemption." link="https://csma-graduation-projects.github.io/en/doctor.html#qualification" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1059" width="408" height="356" as="geometry" /></mxCell></object><object id="qualification-revise" label="Revise and recheck&#10;&#10;Address foundational gaps,&#10;reassessment or plan changes and&#10;retain the formal outcome." link="https://csma-graduation-projects.github.io/en/templates.html#annual-check" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1059" width="310" height="180" as="geometry" /></mxCell></object><object id="proposal" label="Research Direction, Linked Studies and&#10;Formal Proposal&#10;&#10;Justify the problem, original contribution, methods and&#10;contingency plans." link="https://csma-graduation-projects.github.io/en/doctor.html#proposal" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1530" width="408" height="164" as="geometry" /></mxCell></object><object id="proposal-check" label="Proposal approved and&#10;required corrections&#10;completed?&#10;&#10;Confirm major changes in direction or&#10;methods through the required&#10;process." link="https://csma-graduation-projects.github.io/en/doctor.html#proposal" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1809" width="408" height="325" as="geometry" /></mxCell></object><object id="proposal-revise" label="Revise and recheck&#10;&#10;Revise the question, methods and&#10;resources in response to review; seek&#10;reassessment where required." link="https://csma-graduation-projects.github.io/en/templates.html#proposal" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1809" width="310" height="180" as="geometry" /></mxCell></object><object id="research" label="Independent Research, Evidence Testing&#10;and Iteration&#10;&#10;Conduct research and test counterexamples, alternative&#10;explanations and key assumptions." link="https://csma-graduation-projects.github.io/en/doctor.html#research" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2249" width="408" height="164" as="geometry" /></mxCell></object><object id="annual-review" label="Ongoing Annual Reflection, Interim&#10;Assessment and Replanning&#10;&#10;Revisit progress, requirements and the research agenda&#10;at scheduled reviews." link="https://csma-graduation-projects.github.io/en/doctor.html#annual-review" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2528" width="408" height="164" as="geometry" /></mxCell></object><object id="annual-review-check" label="Current review and evidence&#10;conditions met?&#10;&#10;Check formal review status and core&#10;evidence separately; repeat at later&#10;scheduled reviews." link="https://csma-graduation-projects.github.io/en/doctor.html#annual-review" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2807" width="408" height="307" as="geometry" /></mxCell></object><object id="annual-review-revise" label="Revise and recheck&#10;&#10;Gather evidence, narrow claims or&#10;revise the agenda; handle an&#10;unsuccessful review through the formal&#10;process." link="https://csma-graduation-projects.github.io/en/templates.html#midterm" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="2807" width="310" height="180" as="geometry" /></mxCell></object><object id="contributions" label="Original Contributions, Output Recognition&#10;and Scholarly Exchange&#10;&#10;Connect studies and verify original contributions and&#10;individual responsibility." link="https://csma-graduation-projects.github.io/en/doctor.html#contributions" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="3229" width="408" height="164" as="geometry" /></mxCell></object><object id="writing" label="Dissertation Synthesis and Academic&#10;Integrity Checks&#10;&#10;Organize the thesis around evidence and complete&#10;applicable submission checks." link="https://csma-graduation-projects.github.io/en/doctor.html#writing" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="3508" width="408" height="164" as="geometry" /></mxCell></object><object id="review" label="Preliminary Defence, Dissertation Review&#10;and Responses&#10;&#10;Follow local requirements for pre-defense, thesis review&#10;and responses." link="https://csma-graduation-projects.github.io/en/doctor.html#review" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="3787" width="408" height="164" as="geometry" /></mxCell></object><object id="review-check" label="Review resolved and defense&#10;eligibility confirmed?&#10;&#10;Follow the official outcome for&#10;revision, re-review or appeals." link="https://csma-graduation-projects.github.io/en/doctor.html#review" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="4066" width="408" height="275" as="geometry" /></mxCell></object><object id="review-revise" label="Revise and recheck&#10;&#10;Respond point by point, add evidence&#10;and revise; arrange re-review or deferral&#10;as required." link="https://csma-graduation-projects.github.io/en/templates.html#review-response" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="4066" width="310" height="180" as="geometry" /></mxCell></object><object id="defense" label="Formal Defence, Revision Approval and&#10;Degree Application&#10;&#10;Defend after eligibility is confirmed, then complete&#10;corrections and degree procedures." link="https://csma-graduation-projects.github.io/en/doctor.html#defense" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="4456" width="408" height="164" as="geometry" /></mxCell></object><object id="defense-check" label="Post-defense corrections&#10;and submissions confirmed?&#10;&#10;Record degree-conferral status&#10;separately, based on the institution’s&#10;official decision." link="https://csma-graduation-projects.github.io/en/doctor.html#defense" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="4735" width="408" height="314" as="geometry" /></mxCell></object><object id="defense-revise" label="Revise and recheck&#10;&#10;Revise and verify according to the&#10;defense decision; follow the required&#10;process for any further defense." link="https://csma-graduation-projects.github.io/en/templates.html#defense" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="4735" width="310" height="180" as="geometry" /></mxCell></object><object id="archive" label="Research Archive, Handover and Future&#10;Development&#10;&#10;Verify recoverable records, handover responsibilities&#10;and future research directions." link="https://csma-graduation-projects.github.io/en/doctor.html#archive" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="5164" width="408" height="164" as="geometry" /></mxCell></object><mxCell id="edge-0" value="Not met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="qualification-check" target="qualification-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="Return for evidence and revision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="qualification-revise" target="foundation"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="879" y="1149.0" /><mxPoint x="879" y="481" /><mxPoint x="422" y="481" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-2" value="Not met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;stroke