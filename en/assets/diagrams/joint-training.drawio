<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-joint-training" name="Joint training across institutions"><mxGraphModel dx="920" dy="3386" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="3386" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Joint training across institutions" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="Seven working steps connect hosting or sending arrangements, shared supervision, formal recognition and handover. Three&#10;checks show when to revise or seek confirmation." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="52" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="132" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: This is working guidance, not an approved institutional programme. Supervisory agreement, institutional&#10;approval, completed research and formal recognition are distinct. Apply the rules and authorised decisions relevant to each&#10;student; shared supervision does not itself confer a joint or double degree." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="3255" width="840" height="71" as="geometry" /></mxCell><object id="scope" label="Identify the arrangement and roles&#10;&#10;Record hosting or sending roles, enrolment, awarding&#10;institution and scope." link="https://csma-graduation-projects.github.io/en/joint-training.html#types" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="222" width="408" height="150" as="geometry" /></mxCell></object><object id="requirements" label="Check requirements and procedures&#10;&#10;Confirm hosting, supervision eligibility, recognition and&#10;responsible offices." link="https://csma-graduation-projects.github.io/en/joint-training.html#stages" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="487" width="408" height="150" as="geometry" /></mxCell></object><object id="entry-check" label="Ready to start?&#10;&#10;Required approvals, resource access&#10;and hosting arrangements are&#10;documented." link="https://csma-graduation-projects.github.io/en/joint-training.html#stages" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="752" width="408" height="240" as="geometry" /></mxCell></object><object id="entry-revise" label="Resolve missing conditions&#10;&#10;Obtain confirmation from the&#10;responsible office before starting&#10;dependent work." link="https://csma-graduation-projects.github.io/en/joint-training.html#stages" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="752" width="310" height="180" as="geometry" /></mxCell></object><object id="plan" label="Agree on the individual plan&#10;&#10;Set learning goals, tasks, responsibilities, deadlines and&#10;review evidence." link="https://csma-graduation-projects.github.io/en/joint-training.html#roles" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1107" width="408" height="150" as="geometry" /></mxCell></object><object id="execute" label="Work and obtain shared feedback&#10;&#10;Use shared task records and versions; track issues and&#10;actions on feedback." link="https://csma-graduation-projects.github.io/en/joint-training.html#coordination" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1372" width="408" height="150" as="geometry" /></mxCell></object><object id="review" label="Review progress and prepare materials&#10;&#10;Self-check, obtain supervisory feedback and prepare&#10;required submissions." link="https://csma-graduation-projects.github.io/en/joint-training.html#stages" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1637" width="408" height="150" as="geometry" /></mxCell></object><object id="stage-check" label="Do outputs meet the agreed&#10;checks?&#10;&#10;Evidence supports the conclusion;&#10;remaining comments and formal&#10;requirements are identified." link="https://csma-graduation-projects.github.io/en/joint-training.html#stages" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1902" width="408" height="296" as="geometry" /></mxCell></object><object id="stage-revise" label="Revise work or the plan&#10;&#10;Record gaps, owners and review dates;&#10;complete required procedures for formal&#10;changes." link="https://csma-graduation-projects.github.io/en/joint-training.html#coordination" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1902" width="310" height="180" as="geometry" /></mxCell></object><object id="recognition" label="Complete applicable formal recognition&#10;&#10;Submit to the authorised offices and keep receipts,&#10;decisions and next steps." link="https://csma-graduation-projects.github.io/en/joint-training.html#stages" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2313" width="408" height="150" as="geometry" /></mxCell></object><object id="recognition-check" label="Is recognition status&#10;resolved?&#10;&#10;Keep formal decisions or a&#10;documented basis for&#10;non-applicability; do not record an&#10;unsuccessful result as a pass." link="https://csma-graduation-projects.github.io/en/joint-training.html#stages" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2578" width="408" height="285" as="geometry" /></mxCell></object><object id="recognition-revise" label="Supplement, request review or&#10;replan&#10;&#10;Respond to missing items or use formal&#10;review channels; agree on interim and&#10;subsequent work." link="https://csma-graduation-projects.github.io/en/joint-training.html#coordination" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="2578" width="310" height="184" as="geometry" /></mxCell></object><object id="handover" label="Continue or complete the handover&#10;&#10;Follow the decisions into the next stage, archive records&#10;and confirm retention and access." link="https://csma-graduation-projects.github.io/en/joint-training.html#closure" tooltip="Completion and next steps"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2978" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="scope" target="requirements"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="requirements" target="entry-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="Continue when met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="entry-check" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="Not yet ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="entry-check" target="entry-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="Return to requirements and procedures" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="entry-revise" target="requirements"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="894" y="842.0" /><mxPoint x="894" y="467" /><mxPoint x="422" y="467" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-5" va