 parent="1" source="stage-check" target="stage-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="Return to the plan and tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="stage-revise" target="plan"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="874" y="1992.0" /><mxPoint x="874" y="1087" /><mxPoint x="422" y="1087" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="recognition" target="recognition-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-12" value="Proceed according to the decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="recognition-check" target="handover"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-13" value="Further action needed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="recognition-check" target="recognition-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-14" value="Return to formal recognition" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="recognition-revise" target="recognition"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="894" y="2670.0" /><mxPoint x="894" y="2293" /><mxPoint x="422" y="2293" /></Array><mxPoint x="-155.0" y="116.5" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
