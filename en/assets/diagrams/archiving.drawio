<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-archiving" name="Archiving and handover: materials to acceptance"><mxGraphModel dx="920" dy="2775" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2775" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Archiving and handover: materials to acceptance" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="Ensure the recipient can locate, open and verify materials, with clear retention and access responsibilities." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: Submit degree materials and hand over research records separately. Keep public copies apart from&#10;controlled originals. Transfer access through organization-approved procedures; do not share personal account passwords." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2665" width="840" height="50" as="geometry" /></mxCell><object id="inventory" label="Organize materials and version index&#10;&#10;List the thesis, code, data, logs, analyses, instructions,&#10;licenses and unfinished work." link="https://csma-graduation-projects.github.io/en/templates.html#archive" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="200" width="408" height="150" as="geometry" /></mxCell></object><object id="access" label="Check permissions and visibility&#10;&#10;Separate public, team-controlled and restricted access.&#10;Remove sensitive information from public copies." link="https://csma-graduation-projects.github.io/en/archive.html#visibility-model" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="465" width="408" height="150" as="geometry" /></mxCell></object><object id="access-check" label="Are publication and transfer&#10;permissions clear?&#10;&#10;Having downloaded or accessed&#10;material does not grant permission to&#10;publish it." link="https://csma-graduation-projects.github.io/en/archive.html#visibility-model" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="730" width="408" height="299" as="geometry" /></mxCell></object><object id="access-revise" label="Revise and review&#10;&#10;Obtain permission, de-identify or restrict&#10;access. Keep nonpublic material only in&#10;approved locations." link="https://csma-graduation-projects.github.io/en/templates.html#archive" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="730" width="310" height="180" as="geometry" /></mxCell></object><object id="package" label="Prepare the archive and restoration&#10;instructions&#10;&#10;Add data provenance, versions, dependencies,&#10;commands, checksums, owners and retention periods." link="https://csma-graduation-projects.github.io/en/archive.html#archive-metadata" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1144" width="408" height="164" as="geometry" /></mxCell></object><object id="verify" label="Have the recipient test restoration and&#10;reproduction&#10;&#10;Open a sample of files, restore key materials using the&#10;instructions and verify core evidence." link="https://csma-graduation-projects.github.io/en/archive.html#reproduce-and-verify" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1423" width="408" height="164" as="geometry" /></mxCell></object><object id="verify-check" label="Are materials complete and&#10;verifiable as documented?&#10;&#10;Directory screenshots, empty files and&#10;a successful upload do not replace&#10;acceptance checks." link="https://csma-graduation-projects.github.io/en/archive.html#reproduce-and-verify" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1702" width="408" height="292" as="geometry" /></mxCell></object><object id="verify-revise" label="Revise and review&#10;&#10;Add missing records and repeat&#10;acceptance. State the causes and&#10;impact of anything that cannot be&#10;restored." link="https://csma-graduation-projects.github.io/en/templates.html#handover" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1702" width="310" height="180" as="geometry" /></mxCell></object><object id="handover" label="Confirm receipt, access and outstanding&#10;responsibilities&#10;&#10;Record the accepted scope, pending tasks,&#10;account/equipment arrangements and limits of future&#10;contact." link="https://csma-graduation-projects.github.io/en/templates.html#handover" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2109" width="408" height="164" as="geometry" /></mxCell></object><object id="retain" label="Review backups and retention periodically&#10;&#10;Retain materials and control access according to&#10;licenses and institutional requirements; recheck&#10;restoration as agreed." link="https://csma-graduation-projects.github.io/en/archive.html#retention-and-access" tooltip="Completion and next steps"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2388" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="access-check" target="access-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="Return to materials and permissions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="access-revise" target="inventory"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="879" y="820.0" /><mxPoint x="879" y="180" /><mxPoint x="422" y="180" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-2" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="verify-check" target="verify-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="Return to missing records and restoration instructions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="verify-revise" target="package"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="889" y="1792.0" /><mxPoint x="889" y="1124" /><mxPoint x="422" y="1124" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="inventory" target="access"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="access" target="access-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-6" value="Continue when met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="access-check" target="package"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="package" target="verify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="verify" target="verify-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="Continue when met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="verify-check" target="handover"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="handover" target="retain"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
