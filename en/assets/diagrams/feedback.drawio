<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-feedback" name="Routine work: tasks, feedback and next steps"><mxGraphModel dx="920" dy="2457" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2457" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Routine work: tasks, feedback and next steps" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="Turn each discussion into deliverable tasks, owners, evidence and review dates." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: Students and supervisors agree on a working rhythm that fits coursework and research. Use institutional&#10;rules and designated channels for formal attendance, leave, practice and assessment." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2347" width="840" height="50" as="geometry" /></mxCell><object id="plan" label="Agree on goals and completion conditions&#10;&#10;Specify tasks, owners, inputs, deliverables, review dates&#10;and support needed." link="https://csma-graduation-projects.github.io/en/templates.html#research-task" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="200" width="408" height="150" as="geometry" /></mxCell></object><object id="work" label="Execute and retain process records&#10;&#10;Update actual versions and results daily. Report&#10;blockers, their impact and attempted solutions promptly." link="https://csma-graduation-projects.github.io/en/management.html#working-rhythm" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="465" width="408" height="150" as="geometry" /></mxCell></object><object id="work-check" label="Are inputs, resources and&#10;arrangements still workable?&#10;&#10;Seek help early when blocked. Do not&#10;fabricate progress after a deadline." link="https://csma-graduation-projects.github.io/en/management.html#working-rhythm" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="730" width="408" height="270" as="geometry" /></mxCell></object><object id="work-revise" label="Revise and review&#10;&#10;Explain causes and alternatives. Agree&#10;on a smaller scope, a revised date or a&#10;necessary formal change." link="https://csma-graduation-projects.github.io/en/templates.html#change-request" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="730" width="310" height="180" as="geometry" /></mxCell></object><object id="report" label="Submit a weekly report and discussion&#10;points&#10;&#10;Distinguish facts, interpretations and plans; attach&#10;accessible evidence." link="https://csma-graduation-projects.github.io/en/templates.html#weekly" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1115" width="408" height="164" as="geometry" /></mxCell></object><object id="feedback" label="Discuss and record action items&#10;&#10;Record decisions, unresolved questions, revision&#10;locations, owners and deadlines." link="https://csma-graduation-projects.github.io/en/templates.html#meeting" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1394" width="408" height="150" as="geometry" /></mxCell></object><object id="feedback-check" label="Does the delivery meet the&#10;agreed conditions?&#10;&#10;Actual materials support completion&#10;status. Record official assessment&#10;outcomes separately." link="https://csma-graduation-projects.github.io/en/templates.html#meeting" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1659" width="408" height="282" as="geometry" /></mxCell></object><object id="feedback-revise" label="Revise and review&#10;&#10;Address feedback item by item. Keep&#10;disputed conclusions pending&#10;confirmation and arrange another&#10;review." link="https://csma-graduation-projects.github.io/en/templates.html#weekly" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1659" width="310" height="180" as="geometry" /></mxCell></object><object id="close" label="Complete the review and plan the next&#10;cycle&#10;&#10;Record the evidence for completion; give continuing&#10;work a new set of goals." link="https://csma-graduation-projects.github.io/en/management.html#task-status" tooltip="Completion and next steps"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2056" width="408" height="164" as="geometry" /></mxCell></object><mxCell id="edge-0" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="work-check" target="work-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="Return to tasks and arrangements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="work-revise" target="plan"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="879" y="820.0" /><mxPoint x="879" y="180" /><mxPoint x="422" y="180" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-2" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="feedback-check" target="feedback-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="Return to execution and revision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="feedback-revise" target="work"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="889" y="1749.0" /><mxPoint x="889" y="445" /><mxPoint x="422" y="445" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="plan" target="work"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="work" target="work-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-6" value="Continue when met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="work-check" target="report"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="report" target="feedback"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="feedback" target="feedback-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="Continue when met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="feedback-check" target="close"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
