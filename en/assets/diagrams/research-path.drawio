<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-research-path" name="Undergraduate research training workflow"><mxGraphModel dx="920" dy="3264" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="3264" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Undergraduate research training workflow" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="The main route covers all 7 stages. Decision nodes state when to continue; side branches show where to return if conditions&#10;are not met." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="52" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="132" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: This is a guide to the work involved. Learning, research and writing may overlap. Formal approval,&#10;recognition of outputs and degree conferral follow the rules applicable to you and your institution's decisions." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="3154" width="840" height="50" as="geometry" /></mxCell><object id="orientation" label="Orientation and mutual fit&#10;&#10;Agree on goals, time, resources and communication." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#orientation" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="222" width="408" height="150" as="geometry" /></mxCell></object><object id="orientation-check" label="Do the task and available&#10;time fit?&#10;&#10;Both parties confirm the scope and&#10;review date." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#orientation" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="487" width="408" height="240" as="geometry" /></mxCell></object><object id="orientation-revise" label="Revise and review&#10;&#10;Reduce the task, strengthen foundations&#10;or adjust the schedule. Pause or leave&#10;the training if it is not a suitable fit." link="https://csma-graduation-projects.github.io/en/templates.html#onboarding" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="487" width="310" height="180" as="geometry" /></mxCell></object><object id="foundation" label="Tools, literature and research practice&#10;&#10;Set up the environment and establish reading and&#10;evidence-recording habits." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#foundation" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="842" width="408" height="150" as="geometry" /></mxCell></object><object id="exploration" label="Reading, replication and small tasks&#10;&#10;Use small reading and replication tasks to test whether&#10;a question merits research." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#exploration" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1107" width="408" height="150" as="geometry" /></mxCell></object><object id="exploration-check" label="Does the evidence justify&#10;continuing?&#10;&#10;Explain the replication results, value&#10;and resource requirements." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#exploration" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1372" width="408" height="240" as="geometry" /></mxCell></object><object id="exploration-revise" label="Revise and review&#10;&#10;Check data and environment issues&#10;first. If the question lacks value, change&#10;it or stop, preserving negative findings." link="https://csma-graduation-projects.github.io/en/templates.html#experiment" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1372" width="310" height="180" as="geometry" /></mxCell></object><object id="project" label="Project plan and task breakdown&#10;&#10;Define milestones, responsibilities and verifiable&#10;deliverables." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#project" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1727" width="408" height="150" as="geometry" /></mxCell></object><object id="execution" label="Execution, weekly reports and reviews&#10;&#10;Keep versions and logs; use feedback to plan the next&#10;tasks." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#execution" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1992" width="408" height="150" as="geometry" /></mxCell></object><object id="validation" label="Result verification and communication&#10;&#10;Check claims, contributions, citations and permission to&#10;publish." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#validation" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2257" width="408" height="150" as="geometry" /></mxCell></object><object id="validation-check" label="Can the results be checked?&#10;&#10;Key claims match actual records, and&#10;usage permissions are clear." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#validation" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2522" width="408" height="240" as="geometry" /></mxCell></object><object id="validation-revise" label="Revise and review&#10;&#10;Add experiments or narrow the claims.&#10;Withhold material without clear&#10;permission, and review again before&#10;closing the project." link="https://csma-graduation-projects.github.io/en/templates.html#experiment" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="2522" width="310" height="180" as="geometry" /></mxCell></object><object id="archive" label="Closure, archiving and next steps&#10;&#10;Complete acceptance, reflection and follow-on&#10;arrangements." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#archive" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2877" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="orientation-check" target="orientation-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="Return to fit and agreements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="orientation-revise" target="orientation"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="879" y="577.0" /><mxPoint x="879" y="202" /><mxPoint x="422" y="202" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-2" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="exploration-check" target="exploration-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="Return to reading and small tests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="exploration-revise" target="exploration"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="889" y="1462.0" /><mxPoint x="889" y="1087" /><mxPoint x="422" y="1087" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-4" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="validation-check" target="validation-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="Return to execution and evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="validation-revise" target="execution"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="874" y="2612.0" /><mxPoint x="874" y="1972" /><mxPoint x="422" y="1972" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="orientation" target="orientation-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="Continue when met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="orientation-check" target="foundation"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="foundation" target="exploration"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="exploration" target="exploration-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="Continue when met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="exploration-check" target="project"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="project" target="execution"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="execution" target="validation"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;" edge="1" parent="1" source="validation" target="validation-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-14" value="Continue when met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial;whiteSpace=wrap;labelWidth=155;" edge="1" parent="1" source="validation-check" target="archive"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
