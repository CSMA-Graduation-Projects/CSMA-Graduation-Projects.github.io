<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-engineering" name="Engineering: from requirements to acceptance"><mxGraphModel dx="920" dy="2697" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2697" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Engineering: from requirements to acceptance" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="Connect design, implementation, testing and acceptance for capstones and competition projects." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: Choose tools according to risk and task size. A working interface is partial evidence; delivery should cover&#10;core requirements, failure cases and usage boundaries." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2587" width="840" height="50" as="geometry" /></mxCell><object id="requirements" label="Specify requirements and acceptance&#10;conditions&#10;&#10;Confirm user scenarios, scope, individual responsibility&#10;and measurable goals." link="https://csma-graduation-projects.github.io/en/templates.html#engineering-report" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="200" width="408" height="164" as="geometry" /></mxCell></object><object id="design" label="Detailed design and critical prototypes&#10;&#10;Describe interfaces, data, error handling and&#10;dependencies. Test high-risk elements first." link="https://csma-graduation-projects.github.io/en/bachelor.html#design" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="479" width="408" height="150" as="geometry" /></mxCell></object><object id="design-check" label="Can the design meet core&#10;acceptance conditions?&#10;&#10;Critical dependencies and the&#10;technical approach have passed small&#10;tests." link="https://csma-graduation-projects.github.io/en/bachelor.html#design" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="744" width="408" height="283" as="geometry" /></mxCell></object><object id="design-revise" label="Revise and review&#10;&#10;Clarify requirements or change the&#10;design. Record the impact of significant&#10;scope changes and obtain agreement." link="https://csma-graduation-projects.github.io/en/templates.html#change-request" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="744" width="310" height="180" as="geometry" /></mxCell></object><object id="implement" label="Implement a complete minimal user journey&#10;&#10;Expand through version control and task records while&#10;keeping run instructions usable." link="https://csma-graduation-projects.github.io/en/bachelor.html#implementation" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1142" width="408" height="150" as="geometry" /></mxCell></object><object id="test" label="Test and organize evidence&#10;&#10;Cover core functions, boundary cases and failures;&#10;record the environment and results." link="https://csma-graduation-projects.github.io/en/bachelor.html#validation" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1407" width="408" height="150" as="geometry" /></mxCell></object><object id="accept" label="Demonstrate and accept against&#10;requirements&#10;&#10;Check the deliverable version, explaining implemented&#10;scope, defects and limitations." link="https://csma-graduation-projects.github.io/en/templates.html#engineering-report" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1672" width="408" height="164" as="geometry" /></mxCell></object><object id="accept-check" label="Do the core goals pass&#10;acceptance?&#10;&#10;Planned features are not described as&#10;already implemented." link="https://csma-graduation-projects.github.io/en/templates.html#engineering-report" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1951" width="408" height="244" as="geometry" /></mxCell></object><object id="accept-revise" label="Revise and review&#10;&#10;Fix defects and retest. If goals cannot&#10;be met, revise the scope and&#10;explanation, then seek renewed&#10;agreement." link="https://csma-graduation-projects.github.io/en/templates.html#engineering-report" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1951" width="310" height="180" as="geometry" /></mxCell></object><object id="deliver" label="Release or hand over the agreed version&#10;&#10;Confirm publication permission, dependency licenses,&#10;rollback procedures and receipt." link="https://csma-graduation-projects.github.io/en/templates.html#handover" tooltip="Completion and next steps"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2310" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="design-check" target="design-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="Return to requirements and design" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="design-revise" target="requirements"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="879" y="834.0" /><mxPoint x="879" y="180" /><mxPoint x="422" y="180" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-2" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="accept-check" target="accept-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="Return to implementation and retesting" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="accept-revise" target="implement"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="889" y="2041.0" /><mxPoint x="889" y="1122" /><mxPoint x="422" y="1122" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-4" valu