<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-reproduction" name="Replication: from environment to evidence"><mxGraphModel dx="920" dy="2632" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2632" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Replication: from environment to evidence" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="Distinguish environment checks, offline recalculation, actual execution and research conclusions." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: Replication does not guarantee identical numerical results. Explain differences in data, configuration or&#10;evaluation, and limit claims accordingly. Retain failure and timeout records." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2522" width="840" height="50" as="geometry" /></mxCell><object id="target" label="Define the replication target and baseline&#10;&#10;Identify the paper version, target claim, data license and&#10;evaluation definitions." link="https://csma-graduation-projects.github.io/en/templates.html#experiment" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="200" width="408" height="150" as="geometry" /></mxCell></object><object id="environment" label="Freeze the environment and run a small test&#10;&#10;Record code version, dependencies, hardware, data&#10;splits, configuration and startup commands." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#foundation" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="465" width="408" height="150" as="geometry" /></mxCell></object><object id="environment-check" label="Do the small test and&#10;resource conditions pass?&#10;&#10;A successful installation is not a&#10;completed experiment." link="https://csma-graduation-projects.github.io/en/undergraduate-research.html#foundation" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="730" width="408" height="244" as="geometry" /></mxCell></object><object id="environment-revise" label="Revise and review&#10;&#10;Identify dependency, data, access or&#10;computing-resource issues. Reduce the&#10;trial if needed and rerun it." link="https://csma-graduation-projects.github.io/en/templates.html#experiment" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="730" width="310" height="180" as="geometry" /></mxCell></object><object id="run" label="Run the predefined experiments&#10;&#10;Save actual commands, times, exit status, full logs and&#10;raw outputs." link="https://csma-graduation-projects.github.io/en/master.html#research" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1089" width="408" height="150" as="geometry" /></mxCell></object><object id="analysis" label="Analyze results and differences&#10;&#10;Use the predefined rules for failures, statistical&#10;uncertainty and comparison conditions." link="https://csma-graduation-projects.github.io/en/integrity.html#integrity-evidence" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1354" width="408" height="150" as="geometry" /></mxCell></object><object id="recheck" label="Check key claims against records&#10;&#10;Repeat key steps in the declared environment, or state&#10;the exact scope of offline recalculation." link="https://csma-graduation-projects.github.io/en/archive.html#reproduce-and-verify" tooltip="Work step"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1619" width="408" height="150" as="geometry" /></mxCell></object><object id="recheck-check" label="Does the evidence support&#10;the current claims?&#10;&#10;Each result is traceable to a specific&#10;version and original record." link="https://csma-graduation-projects.github.io/en/archive.html#reproduce-and-verify" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1884" width="408" height="246" as="geometry" /></mxCell></object><object id="recheck-revise" label="Revise and review&#10;&#10;Investigate differences, add experiments&#10;or narrow claims. Do not discard&#10;unfavorable cases to obtain a desired&#10;result." link="https://csma-graduation-projects.github.io/en/templates.html#experiment" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1884" width="310" height="180" as="geometry" /></mxCell></object><object id="package" label="Prepare a verifiable experiment package&#10;&#10;Include configuration, logs, analysis scripts, README,&#10;limitations and licenses." link="https://csma-graduation-projects.github.io/en/templates.html#archive" tooltip="Completion and next steps"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2245" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="environment-check" target="environment-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="Return to environment and small test" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="environment-revise" target="environment"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="879" y="820.0" /><mxPoint x="879" y="445" /><mxPoint x="422" y="445" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-2" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="recheck-check" target="recheck-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="Return to execution and validation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="recheck-revise" target="run"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="889" y="1974.0" /><mxPoint x="889" y="1069" /><mxPoint x="422" y="1069" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mxGeometry></mxC