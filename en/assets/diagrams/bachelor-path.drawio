<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-bachelor-path" name="Undergraduate capstone / thesis workflow"><mxGraphModel dx="920" dy="3639" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="3639" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Undergraduate capstone / thesis workflow" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="The main route covers all 8 stages. Decision nodes state when to continue; side branches show where to return if conditions&#10;are not met." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="52" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="132" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: This is a guide to the work involved. Learning, research and writing may overlap. Formal approval,&#10;recognition of outputs and degree conferral follow the rules applicable to you and your institution's decisions." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="3529" width="840" height="50" as="geometry" /></mxCell><object id="topic" label="Requirements, topic and task brief&#10;&#10;Check formal requirements; agree on scope and&#10;individual responsibilities." link="https://csma-graduation-projects.github.io/en/bachelor.html#topic" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="222" width="408" height="150" as="geometry" /></mxCell></object><object id="proposal" label="Literature review and proposal&#10;&#10;Prepare the review, research question, approach and&#10;proposal materials." link="https://csma-graduation-projects.github.io/en/bachelor.html#proposal" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="487" width="408" height="150" as="geometry" /></mxCell></object><object id="proposal-check" label="Does the formal proposal&#10;meet requirements?&#10;&#10;Follow the department's official&#10;decision and required revisions." link="https://csma-graduation-projects.github.io/en/bachelor.html#proposal" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="752" width="408" height="240" as="geometry" /></mxCell></object><object id="proposal-revise" label="Revise and review&#10;&#10;Revise the topic, approach or validation&#10;plan in response to feedback, and seek&#10;a new review as instructed." link="https://csma-graduation-projects.github.io/en/templates.html#review-response" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="752" width="310" height="180" as="geometry" /></mxCell></object><object id="design" label="Requirements analysis and detailed design&#10;&#10;Connect core requirements to design decisions and&#10;acceptance methods." link="https://csma-graduation-projects.github.io/en/bachelor.html#design" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1107" width="408" height="150" as="geometry" /></mxCell></object><object id="implementation" label="Implementation and mid-program review&#10;&#10;Complete core functions and submit an accurate&#10;progress record." link="https://csma-graduation-projects.github.io/en/bachelor.html#implementation" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1372" width="408" height="150" as="geometry" /></mxCell></object><object id="implementation-check" label="Are mid-program conditions&#10;met?&#10;&#10;Check core implementation, the&#10;official review outcome and remaining&#10;tasks." link="https://csma-graduation-projects.github.io/en/bachelor.html#implementation" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1637" width="408" height="303" as="geometry" /></mxCell></object><object id="implementation-revise" label="Revise and review&#10;&#10;Prioritize missing core functionality,&#10;record corrections and review again. A&#10;plan is not completed work." link="https://csma-graduation-projects.github.io/en/templates.html#change-request" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1637" width="310" height="180" as="geometry" /></mxCell></object><object id="validation" label="Testing, experiments and analysis&#10;&#10;Address the main goals, retaining failure and&#10;boundary-case evidence." link="https://csma-graduation-projects.github.io/en/bachelor.html#validation" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2055" width="408" height="150" as="geometry" /></mxCell></object><object id="writing" label="Thesis writing and compliance checks&#10;&#10;Complete the argument, references, formatting and&#10;required institutional checks." link="https://csma-graduation-projects.github.io/en/bachelor.html#writing" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2320" width="408" height="150" as="geometry" /></mxCell></object><object id="defense" label="Defense preparation and participation&#10;&#10;Check eligibility and materials, prepare a verifiable&#10;demonstration and attend the formal defense." link="https://csma-graduation-projects.github.io/en/bachelor.html#defense" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2585" width="408" height="150" as="geometry" /></mxCell></object><object id="defense-check" label="Does the official defense&#10;decision allow finalization?&#10;&#10;Fulfil every condition, including&#10;revisions required for a conditional&#10;pass." link="https://csma-graduation-projects.github.io/en/bachelor.html#defense" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2850" width="408" height="287" as="geometry" /></mxCell></object><object id="defense-revise" label="Revise and review&#10;&#10;Revise, seek further review or reapply&#10;under institutional rules. Report&#10;demonstration failures accurately." link="https://csma-graduation-projects.github.io/en/templates.html#review-response" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="2850" width="310" height="180" as="geometry" /></mxCell></object><object id="archive" label="Final revisions, archiving and handover&#10;&#10;Address defense feedback, submit institutional materials&#10;and hand over research records." link="https://csma-graduation-projects.github.io/en/bachelor.html#archive" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="3252" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-