<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-master-path" name="Master's research and degree workflow"><mxGraphModel dx="920" dy="6228" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="6228" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="Master's research and degree workflow" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="The main route covers all 13 stages. Decision nodes state when to continue; side branches show where to return if conditions&#10;are not met." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="52" as="geometry" /></mxCell><mxCell id="diagram-legend" value="Follow the downward route; unmet conditions lead to the right-hand correction branch, then return along the dashed line. Select a&#10;node for its online guide." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="132" width="840" height="50" as="geometry" /></mxCell><mxCell id="diagram-note" value="Scope and limits: This is a guide to the work involved. Learning, research and writing may overlap. Formal approval,&#10;recognition of outputs and degree conferral follow the rules applicable to you and your institution's decisions. Check separately&#10;whether a pre-defense is required and where it falls in relation to screening and thesis review." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="6097" width="840" height="71" as="geometry" /></mxCell><object id="orientation" label="Enrollment, study plan and working&#10;agreements&#10;&#10;Check training and outcome requirements at entry;&#10;agree on communication and reviews." link="https://csma-graduation-projects.github.io/en/master.html#orientation" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="222" width="408" height="164" as="geometry" /></mxCell></object><object id="topic" label="Exploration and topic selection&#10;&#10;Select a question using actual needs, preliminary tests&#10;and available resources." link="https://csma-graduation-projects.github.io/en/master.html#topic" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="501" width="408" height="150" as="geometry" /></mxCell></object><object id="survey" label="Literature review and research positioning&#10;&#10;Search, read and compare work to explain how your&#10;study relates to it." link="https://csma-graduation-projects.github.io/en/master.html#survey" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="766" width="408" height="150" as="geometry" /></mxCell></object><object id="proposal" label="Research plan and formal proposal review&#10;&#10;Align the question, methods, evaluation and schedule;&#10;attend the formal proposal review." link="https://csma-graduation-projects.github.io/en/master.html#proposal" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="1429" width="408" height="150" as="geometry" /></mxCell></object><object id="proposal-check" label="Is the proposal approved or&#10;revision completed?&#10;&#10;Use institutional procedures for a new&#10;review or substantial changes." link="https://csma-graduation-projects.github.io/en/master.html#proposal" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1694" width="408" height="255" as="geometry" /></mxCell></object><object id="proposal-revise" label="Revise and review&#10;&#10;Address feedback, narrowing the topic&#10;or changing methods where needed.&#10;Apply for a new review if required and&#10;retain the official decision." link="https://csma-graduation-projects.github.io/en/templates.html#review-response" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1694" width="310" height="182" as="geometry" /></mxCell></object><object id="research" label="Research, professional practice and&#10;records&#10;&#10;Build verifiable evidence through actual execution,&#10;practice and weekly reports." link="https://csma-graduation-projects.github.io/en/master.html#research" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2064" width="408" height="164" as="geometry" /></mxCell></object><object id="midterm" label="Mid-program review and annual&#10;assessment&#10;&#10;Check research progress and all compulsory&#10;components against the notice." link="https://csma-graduation-projects.github.io/en/master.html#midterm" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="2343" width="408" height="164" as="geometry" /></mxCell></object><object id="midterm-check" label="Review conditions met and&#10;core claims supported?&#10;&#10;Assess formal review and research&#10;completion separately; outline and&#10;methods drafting can proceed in&#10;parallel." link="https://csma-graduation-projects.github.io/en/master.html#midterm" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2622" width="408" height="326" as="geometry" /></mxCell></object><object id="midterm-revise" label="Revise and review&#10;&#10;Return to research for missing core&#10;evidence; address an unsuccessful&#10;formal review through its own process&#10;and record both states." link="https://csma-graduation-projects.github.io/en/templates.html#annual-check" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="2622" width="310" height="182" as="geometry" /></mxCell></object><object id="writing" label="Thesis structure, draft and revision&#10;&#10;Build the argument from available results; preserve&#10;supervisory feedback and revisions." link="https://csma-graduation-projects.github.io/en/master.html#writing" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="3063" width="408" height="150" as="geometry" /></mxCell></object><object id="outcomes" label="Research outputs and degree eligibility&#10;&#10;Complete the final verification of requirements checked&#10;from entry and the supporting evidence." link="https://csma-graduation-projects.github.io/en/master.html#outcomes" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="3328" width="408" height="150" as="geometry" /></mxCell></object><object id="integrity" label="Formatting, similarity, error and AI-use&#10;checks&#10;&#10;Distinguish similarity screening, non-academic-error&#10;checks and AI-use disclosure." link="https://csma-graduation-projects.github.io/en/master.html#integrity" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="3593" width="408" height="164" as="geometry" /></mxCell></object><object id="integrity-check" label="Are eligibility and all checks&#10;confirmed?&#10;&#10;Verify output, similarity,&#10;non-academic-error and AI&#10;requirements separately." link="https://csma-graduation-projects.github.io/en/master.html#integrity" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="3872" width="408" height="301" as="geometry" /></mxCell></object><object id="integrity-revise" label="Revise and review&#10;&#10;Address the specific cause: add&#10;evidence, revise, repeat checks or&#10;change the application date. Do not&#10;invent thresholds." link="https://csma-graduation-projects.github.io/en/templates.html#integrity" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="3872" width="310" height="180" as="geometry" /></mxCell></object><object id="review" label="Anonymous thesis review and responses&#10;&#10;Freeze the submitted version, arrange anonymous&#10;review and address each comment." link="https://csma-graduation-projects.github.io/en/master.html#review" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="4288" width="408" height="150" as="geometry" /></mxCell></object><object id="review-check" label="Is defense eligibility formally&#10;confirmed?&#10;&#10;Follow official decisions on reviews,&#10;further review or appeals." link="https://csma-graduation-projects.github.io/en/master.html#review" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="4553" width="408" height="267" as="geometry" /></mxCell></object><object id="review-revise" label="Revise and review&#10;&#10;Respond item by item; revise, seek&#10;further review or defer as required. Do&#10;not privately influence reviewers." link="https://csma-graduation-projects.github.io/en/templates.html#review-response" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="4553" width="310" height="180" as="geometry" /></mxCell></object><object id="defense" label="Defense application and formal defense&#10;&#10;Meet official prerequisites, apply and attend the formal&#10;defense." link="https://csma-graduation-projects.github.io/en/master.html#defense" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="4935" width="408" height="150" as="geometry" /></mxCell></object><object id="defense-check" label="Does the official decision&#10;allow the next steps?&#10;&#10;Passing the defense does not mean&#10;the degree has been conferred." link="https://csma-graduation-projects.github.io/en/master.html#defense" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="5200" width="408" height="240" as="geometry" /></mxCell></object><object id="defense-revise" label="Revise and review&#10;&#10;Revise or reapply according to the&#10;formal decision and institutional&#10;timetable." link="https://csma-graduation-projects.github.io/en/templates.html#review-response" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="5200" width="310" height="180" as="geometry" /></mxCell></object><object id="final" label="Final revisions and degree procedures&#10;&#10;Obtain revision confirmation, submit the final thesis and&#10;complete degree procedures." link="https://csma-graduation-projects.github.io/en/master.html#final" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="5555" width="408" height="150" as="geometry" /></mxCell></object><object id="archive" label="Research archive, handover and departure&#10;&#10;Complete research-material acceptance and transfer&#10;access and responsibilities separately." link="https://csma-graduation-projects.github.io/en/master.html#archive" tooltip="Study stage"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="36" y="5820" width="408" height="150" as="geometry" /></mxCell></object><object id="survey-check" label="Positioning and feasibility&#10;still supported?&#10;&#10;Check whether the question is already&#10;resolved and essential data are&#10;accessible." link="https://csma-graduation-projects.github.io/en/master.html#survey" tooltip="Decision"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontFamily=Arial;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1031" width="408" height="283" as="geometry" /></mxCell></object><object id="survey-revise" label="Revise the question and&#10;search&#10;&#10;Return to topic selection with the&#10;comparison matrix; reassess literature&#10;and resources for the revised question." link="https://csma-graduation-projects.github.io/en/templates.html#topic" tooltip="Correction branch"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="1031" width="310" height="184" as="geometry" /></mxCell></object><mxCell id="edge-0" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="proposal-check" target="proposal-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="Return to topic and proposal revisions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="proposal-revise" target="topic"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="879" y="1785.0" /><mxPoint x="879" y="481" /><mxPoint x="422" y="481" /></Array><mxPoint x="-155.0" y="115.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-2" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="midterm-check" target="midterm-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="Return to research and missing requirements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="midterm-revise" target="research"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="889" y="2713.0" /><mxPoint x="889" y="2044" /><mxPoint x="422" y="2044" /></Array><mxPoint x="-155.0" y="115.5" as="offset" /></mxGeometry></mxCell><mxCell id="edge-4" value="Not yet met" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;whiteSpace=wrap;labelWidth=82;" edge="1" parent="1" source="integrity-check" target="integrity-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="Return to writing and eligibility checks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=1;exitY=0.5;entryX=0.95;entryY=0;fontFamily=Arial;whiteSpace=wrap;fontSize=11;labelWidth=280;" edge="1" parent="1" source="integrity-revise" target="writing"><mxGeometry relative="1" as="geometry" x="-1" y="0" width="280" height="21"><Array as="points"><mxPoint x="874" y="3962.0" /><mxPoint x="874" y="3043" /><mxPoint x="422" y="3043" /></Array><mxPoint x="-155.0" y="114.5" as="offset" /></mx