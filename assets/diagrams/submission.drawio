<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-submission" name="论文提交：检查、评阅与答辩"><mxGraphModel dx="920" dy="3221" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="3221" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="论文提交：检查、评阅与答辩" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="把文件版本、正式检查、送审意见和学位手续连在一起。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：学校是否设置预答辩、查非及其具体顺序各不相同，应先核对适用制度；论文检查、评阅、答辩与学位授予是不同状&#10;态。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="3111" width="840" height="50" as="geometry" /></mxCell><object id="rules" label="核对资格、窗口与正式程序&#10;&#10;确认培养成果、预答辩安排、平台、模板和截止日期。" link="https://csma-graduation-projects.github.io/policies.html#local-check" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="draft" label="完成论文与导师审阅&#10;&#10;将研究结论、引用、图表和附件对应到真实证据。" link="https://csma-graduation-projects.github.io/master.html#writing" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="150" as="geometry" /></mxCell></object><object id="checks" label="分别完成规定检查&#10;&#10;查重、查非与 AI 使用说明分别处理，报告绑定同一版本&#10;。" link="https://csma-graduation-projects.github.io/master.html#integrity" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="709" width="408" height="150" as="geometry" /></mxCell></object><object id="checks-check" label="申请条件与各项检查均满足？&#10;&#10;采用学校指定判定口径，不自设统一阈&#10;值。" link="https://csma-graduation-projects.github.io/master.html#integrity" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="974" width="408" height="240" as="geometry" /></mxCell></object><object id="checks-revise" label="修订与复核&#10;&#10;核实原因并修改、复检或申请复核；实质&#10;修改核对重检要求。" link="https://csma-graduation-projects.github.io/templates.html#integrity" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="974" width="310" height="180" as="geometry" /></mxCell></object><object id="review" label="按要求匿名送审并接收意见&#10;&#10;核对正文、属性、附件与链接；保存版本校验值和回执。" link="https://csma-graduation-projects.github.io/master.html#review" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="150" as="geometry" /></mxCell></object><object id="review-check" label="正式取得答辩资格？&#10;&#10;按评阅、复审或异议处理的正式结论执&#10;行。" link="https://csma-graduation-projects.github.io/master.html#review" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1594" width="408" height="240" as="geometry" /></mxCell></object><object id="review-revise" label="修订与复核&#10;&#10;逐条处理意见，按规定复审或延期；不得&#10;自行宣布通过。" link="https://csma-graduation-projects.github.io/templates.html#review-response" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1594" width="310" height="180" as="geometry" /></mxCell></object><object id="defense" label="申请并参加正式答辩&#10;&#10;按正式资格、委员会安排和通知提交材料、汇报与答询。" link="https://csma-graduation-projects.github.io/master.html#defense" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1949" width="408" height="150" as="geometry" /></mxCell></object><object id="defense-check" label="正式结论允许后续定稿？&#10;&#10;修改后通过仍须落实对应条件。" link="https://csma-graduation-projects.github.io/master.html#defense" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2214" width="408" height="240" as="geometry" /></mxCell></object><object id="defense-revise" label="修订与复核&#10;&#10;依规定整改、复查或再次申请，不承诺再&#10;次答辩结果。" link="https://csma-graduation-projects.github.io/templates.html#review-response" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="2214" width="310" height="180" as="geometry" /></mxCell></object><object id="final" label="修改定稿与学位手续&#10;&#10;落实意见、签字与接收，学位状态以学校正式决定为准。" link="https://csma-graduation-projects.github.io/master.html#final" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2569" width="408" height="150" as="geometry" /></mxCell></object><object id="archive" label="分别完成学位材料与研究归档&#10;&#10;确认学校提交与研究资料接收，保护未公开和敏感材料。" link="https://csma-graduation-projects.github.io/archive.html" tooltip="完成与后续"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2834" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="checks-check" target="checks-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="返回论文与检查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="chec