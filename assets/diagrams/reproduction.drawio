<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-reproduction" name="实验复现：从环境到证据"><mxGraphModel dx="920" dy="2580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2580" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="实验复现：从环境到证据" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="区分环境预检、离线重算、真实运行与研究结论。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：复现不承诺与原文数值完全一致。数据、配置和评价口径不同，应解释差异并限制结论；保留失败与超时记录。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="2491" width="840" height="29" as="geometry" /></mxCell><object id="target" label="确定复现目标与原始基线&#10;&#10;明确论文版本、目标结论、数据许可与评价口径。" link="https://csma-graduation-projects.github.io/templates.html#experiment" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="environment" label="冻结环境与最小运行&#10;&#10;记录代码版本、依赖、硬件、数据划分、配置和启动命令&#10;。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#foundation" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="150" as="geometry" /></mxCell></object><object id="environment-check" label="最小运行及资源条件满足？&#10;&#10;安装成功不等于真实实验已完成。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#foundation" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="709" width="408" height="240" as="geometry" /></mxCell></object><object id="environment-revise" label="修订与复核&#10;&#10;定位依赖、数据、权限或算力问题；缩减&#10;试验后复跑。" link="https://csma-graduation-projects.github.io/templates.html#experiment" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="709" width="310" height="180" as="geometry" /></mxCell></object><object id="run" label="执行预先确定的实验&#10;&#10;保存真实命令、时间、退出状态、完整日志和原始输出。" link="https://csma-graduation-projects.github.io/master.html#research" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1064" width="408" height="150" as="geometry" /></mxCell></object><object id="analysis" label="分析结果与差异&#10;&#10;按事先规则处理失败、统计不确定性和比较条件。" link="https://csma-graduation-projects.github.io/integrity.html#integrity-evidence" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="150" as="geometry" /></mxCell></object><object id="recheck" label="由记录复查关键结论&#10;&#10;在声明的环境重新执行关键步骤或明确离线复算范围。" link="https://csma-graduation-projects.github.io/archive.html#reproduce-and-verify" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1594" width="408" height="150" as="geometry" /></mxCell></object><object id="recheck-check" label="证据足以支持当前结论？&#10;&#10;结果能够定位到具体版本和原始记录。" link="https://csma-graduation-projects.github.io/archive.html#reproduce-and-verify" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1859" width="408" height="240" as="geometry" /></mxCell></object><object id="recheck-revise" label="修订与复核&#10;&#10;排查差异、补实验或收窄结论；不能删除&#10;不利样本凑结果。" link="https://csma-graduation-projects.github.io/templates.html#experiment" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1859" width="310" height="180" as="geometry" /></mxCell></object><object id="package" label="形成可复查实验包&#10;&#10;提供配置、日志、分析脚本、README、限制与许可。" link="https://csma-graduation-projects.github.io/templates.html#archive" tooltip="完成与后续"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2214" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="ed