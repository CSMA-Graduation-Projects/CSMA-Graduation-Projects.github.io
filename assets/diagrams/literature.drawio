<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-literature" name="文献调研：从检索到研究定位"><mxGraphModel dx="920" dy="2580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2580" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="文献调研：从检索到研究定位" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="把检索记录、原文核验、比较矩阵与选题决定连接起来。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：文献中的结果、本地复现结果与待验证假设分别记录；发现问题已被解决，应调整问题而不是只替换术语。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="2491" width="840" height="29" as="geometry" /></mxCell><object id="question" label="明确问题与检索边界&#10;&#10;确定关键概念、同义词、数据库、时间范围和纳排标准。" link="https://csma-graduation-projects.github.io/templates.html#literature" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="search" label="检索、去重与筛选&#10;&#10;保存检索式和日期，记录纳入排除原因，获取合法原文。" link="https://csma-graduation-projects.github.io/templates.html#literature" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="150" as="geometry" /></mxCell></object><object id="read" label="精读与原文核验&#10;&#10;核对方法、数据、评价口径、局限与相反证据，追溯引用&#10;。" link="https://csma-graduation-projects.github.io/templates.html#reading" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="709" width="408" height="150" as="geometry" /></mxCell></object><object id="read-check" label="关键证据已覆盖且可核验？&#10;&#10;检查代表性工作与反证，不以条目数量&#10;代替质量。" link="https://csma-graduation-projects.github.io/templates.html#reading" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="974" width="408" height="240" as="geometry" /></mxCell></object><object id="read-revise" label="修订与复核&#10;&#10;补检索、追溯原文或标记不可核验；不引&#10;用虚构条目。" link="https://csma-graduation-projects.github.io/templates.html#literature" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="974" width="310" height="180" as="geometry" /></mxCell></object><object id="compare" label="形成证据矩阵与综述&#10;&#10;围绕问题和方法组织比较，标明已读、未得全文和待核项&#10;。" link="https://csma-graduation-projects.github.io/master.html#survey" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="150" as="geometry" /></mxCell></object><object id="position" label="形成研究定位与验证任务&#10;&#10;说明最接近工作、差异、价值和可检验假设。" link="https://csma-graduation-projects.github.io/templates.html#topic" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1594" width="408" height="150" as="geometry" /></mxCell></object><object id="position-check" label="问题仍有研究价值？&#10;&#10;差异真实存在，范围与资源可支撑验证&#10;。" link="https://csma-graduation-projects.github.io/templates.html#topic" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1859" width="408" height="240" as="geometry" /></mxCell></object><object id="position-revise" label="修订与复核&#10;&#10;缩小问题、调整方向或停止该候选题，保&#10;留判断依据。" link="https://csma-graduation-projects.github.io/templates.html#topic" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1859" width="310" height="180" as="geometry" /></mxCell></object><object id="maintain" label="持续更新文献库&#10;&#10;保存文献元数据、阅读笔记和定位变更依据。" link="https://csma-graduation-projects.github.io/archive.html#archive-metadata" tooltip="完成与后续"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2214" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=