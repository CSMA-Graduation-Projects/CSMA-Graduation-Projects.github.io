ion" target="position-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="满足后继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="position-check" target="maintain"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
