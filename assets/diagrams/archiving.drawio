<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-archiving" name="归档交接：从材料到接收验收"><mxGraphModel dx="920" dy="2601" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2601" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="归档交接：从材料到接收验收" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="让接收者真正找到、打开并复查材料，明确保存和访问责任。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：学位材料提交与研究资料交接分别办理；公开版与受控原件分开，账号权限通过组织批准的方式转移，不要求共享个&#10;人账号密码。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="2491" width="840" height="50" as="geometry" /></mxCell><object id="inventory" label="整理材料与版本索引&#10;&#10;列出论文、代码、数据、日志、分析、说明、许可及未完&#10;事项。" link="https://csma-graduation-projects.github.io/templates.html#archive" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="access" label="核对授权与可见范围&#10;&#10;区分公开、组内受控、限制访问，清除公开副本敏感信息&#10;。" link="https://csma-graduation-projects.github.io/archive.html#visibility-model" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="150" as="geometry" /></mxCell></object><object id="access-check" label="公开和移交权限明确？&#10;&#10;可下载或曾接触材料不等于拥有公开权&#10;限。" link="https://csma-graduation-projects.github.io/archive.html#visibility-model" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="709" width="408" height="240" as="geometry" /></mxCell></object><object id="access-revise" label="修订与复核&#10;&#10;申请授权、脱敏或限制访问；不能公开的&#10;内容留在获准位置。" link="https://csma-graduation-projects.github.io/templates.html#archive" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="709" width="310" height="180" as="geometry" /></mxCell></object><object id="package" label="整理归档包与恢复说明&#10;&#10;补充数据来源、版本、依赖、命令、校验值、负责人和保&#10;存期。" link="https://csma-graduation-projects.github.io/archive.html#archive-metadata" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1064" width="408" height="150" as="geometry" /></mxCell></object><object id="verify" label="由接收方检查恢复与复现&#10;&#10;抽查打开文件，按说明恢复关键材料并复查核心证据。" link="https://csma-graduation-projects.github.io/archive.html#reproduce-and-verify" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="150" as="geometry" /></mxCell></object><object id="verify-check" label="材料完整且能够按说明复查？&#10;&#10;目录截图、空文件和上传成功均不能替&#10;代验收。" link="https://csma-graduation-projects.github.io/archive.html#reproduce-and-verify" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1594" width="408" height="240" as="geometry" /></mxCell></object><object id="verify-revise" label="修订与复核&#10;&#10;补齐缺档并重新验收；不可恢复项如实写&#10;明原因和影响。" link="https://csma-graduation-projects.github.io/templates.html#handover" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1594" width="310" height="180" as="geometry" /></mxCell></object><object id="handover" label="确认接收、权限与未完责任&#10;&#10;记录接收范围、待办、账号设备处理和后续联系边界。" link="https://csma-graduation-projects.github.io/templates.html#handover" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1949" width="408" height="150" as="geometry" /></mxCell></object><object id="retain" label="定期备份与保留期复核&#10;&#10;按照许可与单位要求保存、控制访问，并按约定复查可恢&#10;复性。" link="https://csma-graduation-projects.github.io/archive.html#retention-and-access" tooltip="完成与后续"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2214" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="access-check" target="access-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="返回材料与权限清单" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="access-revise" target="inventory"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="917" /><mxPoint x="879" y="917" /><mxPoint x="879" y="159" /><mxPoint x="422" y="159" /></Array></mxGeometry></mxCell><mxCell id="edge-2" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="verify-check" target="verify-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="返回补档与恢复说明" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="verify-revise" target="package"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="1802" /><mxPoint x="889" y="1802" /><mxPoint x="889" y="1044" /><mxPoint x="422" y="1044" /></Array></mxGeometry></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;ort