<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-research-path" name="本科科研训练流程图"><mxGraphModel dx="920" dy="3221" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="3221" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="本科科研训练流程图" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="主线覆盖全部 7 个阶段；判断节点给出继续条件，侧支路说明未满足时回到哪里。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：这是培养工作导航。学习、研究和写作可交叉推进；正式审批、成果认定与学位授予以本人适用制度和学校结论为准&#10;。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="3111" width="840" height="50" as="geometry" /></mxCell><object id="orientation" label="了解方向与双向匹配&#10;&#10;确认目标、时间、资源与沟通约定。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#orientation" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="orientation-check" label="任务与时间匹配？&#10;&#10;双方确认任务范围与检查日期。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#orientation" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="240" as="geometry" /></mxCell></object><object id="orientation-revise" label="修订与复核&#10;&#10;缩小任务、补足基础或调整时间；不适合&#10;时可暂停或退出训练。" link="https://csma-graduation-projects.github.io/templates.html#onboarding" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="444" width="310" height="180" as="geometry" /></mxCell></object><object id="foundation" label="工具、文献与规范入门&#10;&#10;建立环境、阅读记录和真实证据习惯。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#foundation" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="799" width="408" height="150" as="geometry" /></mxCell></object><object id="exploration" label="阅读、复现与小任务验证&#10;&#10;小规模阅读、复现，检验问题是否值得研究。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#exploration" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1064" width="408" height="150" as="geometry" /></mxCell></object><object id="exploration-check" label="证据支持继续投入？&#10;&#10;能解释复现结果、价值与资源条件。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#exploration" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="240" as="geometry" /></mxCell></object><object id="exploration-revise" label="修订与复核&#10;&#10;先排查数据与环境；价值不足则换题或结&#10;束并保留否定结果。" link="https://csma-graduation-projects.github.io/templates.html#experiment" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1329" width="310" height="180" as="geometry" /></mxCell></object><object id="project" label="项目立项与任务拆分&#10;&#10;明确里程碑、分工与可验收产物。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#project" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1684" width="408" height="150" as="geometry" /></mxCell></object><object id="execution" label="实施、周报与阶段复核&#10;&#10;保留版本与日志，用反馈推动下一轮任务。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#execution" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1949" width="408" height="150" as="geometry" /></mxCell></object><object id="validation" label="结果复核与成果表达&#10;&#10;检查结论、贡献、引用和公开授权。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#validation" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2214" width="408" height="150" as="geometry" /></mxCell></object><object id="validation-check" label="结果能够复查？&#10;&#10;主要结论与真实记录相符，使用权限清&#10;楚。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#validation" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2479" width="408" height="240" as="geometry" /></mxCell></object><object id="validation-revise" label="修订与复核&#10;&#10;补实验或收窄结论；授权不清的材料暂不&#10;公开，复核后再结项。" link="https://csma-graduation-projects.github.io/templates.html#experiment" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="2479" width="310" height="180" as="geometry" /></mxCell></object><object id="archive" label="结项、归档与后续发展&#10;&#10;完成接收验收、复盘和后续安排。" link="https://csma-graduation-projects.github.io/undergraduate-research.html#archive" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2834" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="orientation-check" target="orientation-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="返回匹配与约定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="orientation-revise" target="orientation"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="652" /><mxPoint x="879" y="652" /><mxPoint x="879" y="159" /><mxPoint x="422" y="159" /></Array></mxGeometry></mxCell><mxCell id="edge-2" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="exploration-check" target="exploration-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="返回阅读与小验证" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="exploration-revise" target="exploration"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="1537" /><mxPoint x="889" y="1537" /><mxPoint x="889" y="1044" /><mxPoint x="422" y="1044" /></Array></mxGeometry></mxCell><mxCell id="edge-4" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="validation-check" target="validation-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="返回实施与补证据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="validation-revise" target="execution"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="2687" /><mxPoint x="874" y="2687" /><mxPoint x="874" y="1929" /><mxPoint x="422" y="1929" /></Array></mxGeometry></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orientation" target="orientation-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="满足后继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orientation-check" target="foundation"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="foundation" target="exploration"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exploration" target="exploration-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="满足后继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exploration-check" target="project"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="project" target="execution"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="execution" target="validation"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="validation" target="validation-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-14" value="满足后继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="validation-check" target="archive"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
