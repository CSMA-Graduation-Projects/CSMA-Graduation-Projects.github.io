<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-research-collaboration" name="从初次联系到共同科研"><mxGraphModel dx="920" dy="2601" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2601" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="从初次联系到共同科研" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="六个行动连接研究兴趣、初次交流和科研或竞赛合作；两次共同判断，让任务和支持适合双方。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：这是合作交流路径，具体任务、时间与支持由双方协商；不预设名额、资助或录取。暂缓或结束也是正常结果，正式&#10;手续按实际适用情况办理。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="2491" width="840" height="50" as="geometry" /></mxCell><object id="interest" label="找到想探索的问题&#10;&#10;结合公开研究方向，写出兴趣与想学习的能力。" link="https://csma-graduation-projects.github.io/research-collaboration.html#directions" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="contact" label="发送简短合作意向&#10;&#10;介绍背景、可分享作品、时间、参与方式与语言。" link="https://csma-graduation-projects.github.io/research-collaboration.html#contact" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="150" as="geometry" /></mxCell></object><object id="discussion" label="双向交流与任务讨论&#10;&#10;讨论目标、基础、指导支持、资源和可投入时间。" link="https://csma-graduation-projects.github.io/research-collaboration.html#fit" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="709" width="408" height="150" as="geometry" /></mxCell></object><object id="ready" label="能约定合适的起步任务？&#10;&#10;双方理解任务与反馈安排，相关条件能&#10;够落实。" link="https://csma-graduation-projects.github.io/research-collaboration.html#fit" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="974" width="408" height="240" as="geometry" /></mxCell></object><object id="adjust" label="调整方向、时间或准备&#10;&#10;缩小任务或先补基础；也可结束本次交流&#10;，准备好后再联系。" link="https://csma-graduation-projects.github.io/research-collaboration.html#fit" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="974" width="310" height="180" as="geometry" /></mxCell></object><object id="task" label="完成约定的小任务&#10;&#10;按学习目标留下可解释的产物、真实过程和问题。" link="https://csma-graduation-projects.github.io/research-collaboration.html#first-task" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="150" as="geometry" /></mxCell></object><object id="feedback" label="共同复盘与获得反馈&#10;&#10;交流成果、困难、个人贡献与所需支持。" link="https://csma-graduation-projects.github.io/research-collaboration.html#first-task" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1594" width="408" height="150" as="geometry" /></mxCell></object><object id="continue" label="双方愿意且具备条件继续？&#10;&#10;确认方向匹配、指导能力、任务条件和&#10;各自安排。" link="https://csma-graduation-projects.github.io/research-collaboration.html#next" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1859" width="408" height="240" as="geometry" /></mxCell></object><object id="replan" label="调整计划或友好结束&#10;&#10;记录反馈和已有贡献；可调整后再讨论，&#10;也可总结后结束。" link="https://csma-graduation-projects.github.io/research-collaboration.html#next" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1859" width="310" height="180" as="geometry" /></mxCell></object><object id="collaborate" label="确认合作并进入持续培养&#10;&#10;写清任务与指导计划；需要访学、学分或学位手续时衔接&#10;联培指南。" link="https://csma-graduation-projects.github.io/research-collaboration.html#next" tooltip="完成与后续"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2214" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="interest" target="contact"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="contact" target="discussion"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="discussion" target="ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="双方约定后" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ready" target="task"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="暂不匹配" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ready" target="adjust"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="如继续，返回讨论" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="adjust" target="discussion"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="1182" /><mxPoint x="874" y="1182" /><mxPoint x="874" y="689" /><mxPoint x="422" y="689" /></Array></mxGeometry></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="task" target="feedback"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="feedback" target="continue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="双方确认后" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="continue" target="collaborate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="需调整或结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="continue" target="replan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="如再尝试，重新讨论" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="replan" target="discussion"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="2067" /><mxPoint x="874" y="2067" /><mxPoint x="874" y="689" /><mxPoint x="422" y="689" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
