<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-doctor-path" name="博士研究与学位全流程图"><mxGraphModel dx="920" dy="5070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="5070" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="博士研究与学位全流程图" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="11 个阶段连接研究主线、原创贡献与正式学位环节；未满足时按支路补证或调整。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：资格考核仅在本人方案要求时执行，开题与资格的先后、预答辩设置及送审顺序按学校规定调整；年度与中期检查贯&#10;穿研究，图中位置只是阅读导航。研究、综述与写作持续迭代，成果条件入学即核对。答辩通过不等于学位授予。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="4960" width="840" height="50" as="geometry" /></mxCell><object id="orientation" label="培养依据、指导关系与成长计划&#10;&#10;核对适用方案、成果条件、语言与指导安排。" link="https://csma-graduation-projects.github.io/doctor.html#orientation" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="foundation" label="学科基础、研究方法与问题地图&#10;&#10;建立文献比较、问题地图与可行性证据。" link="https://csma-graduation-projects.github.io/doctor.html#foundation" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="150" as="geometry" /></mxCell></object><object id="qualification" label="资格考核与研究准备核验（如适用）&#10;&#10;确认是否适用、顺序和形式，按要求完成考核。" link="https://csma-graduation-projects.github.io/doctor.html#qualification" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="709" width="408" height="150" as="geometry" /></mxCell></object><object id="qualification-check" label="当前节点所需资格已确认并满足&#10;？&#10;&#10;按本人正式顺序核对；资格安排在开题&#10;后则登记后续办理节点，不适用须留依&#10;据，待核实不等于免除。" link="https://csma-graduation-projects.github.io/doctor.html#qualification" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="974" width="408" height="319" as="geometry" /></mxCell></object><object id="qualification-revise" label="修订与复核&#10;&#10;按意见补基础、重考或调整计划；保留正&#10;式处理结果。" link="https://csma-graduation-projects.github.io/templates.html#annual-check" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="974" width="310" height="180" as="geometry" /></mxCell></object><object id="proposal" label="研究主线、子问题设计与正式开题&#10;&#10;论证问题价值、原创空间、方法和失败退路。" link="https://csma-graduation-projects.github.io/doctor.html#proposal" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1408" width="408" height="150" as="geometry" /></mxCell></object><object id="proposal-check" label="开题通过且整改完成？&#10;&#10;重大方向或方法调整按规定重新确认。" link="https://csma-graduation-projects.github.io/doctor.html#proposal" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1673" width="408" height="240" as="geometry" /></mxCell></object><object id="proposal-revise" label="修订与复核&#10;&#10;根据评议修订问题、方法和资源安排；必&#10;要时申请重审。" link="https://csma-graduation-projects.github.io/templates.html#proposal" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1673" width="310" height="180" as="geometry" /></mxCell></object><object id="research" label="独立研究、证据检验与迭代&#10;&#10;持续研究并检验反例、替代解释与关键假设。" link="https://csma-graduation-projects.github.io/doctor.html#research" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2028" width="408" height="150" as="geometry" /></mxCell></object><object id="annual-review" label="持续年度回顾、中期考核与方向调整&#10;&#10;按正式检查点反复核对进展、条件与主线。" link="https://csma-graduation-projects.github.io/doctor.html#annual-review" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2293" width="408" height="150" as="geometry" /></mxCell></object><object id="annual-review-check" label="本轮考核与后续证据条件满足？&#10;&#10;正式考核与核心证据分别核对；后续年&#10;度继续检查。" link="https://csma-graduation-projects.github.io/doctor.html#annual-review" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2558" width="408" height="240" as="geometry" /></mxCell></object><object id="annual-review-revise" label="修订与复核&#10;&#10;补证据、缩小主张或调整主线；未通过按&#10;正式程序整改。" link="https://csma-graduation-projects.github.io/templates.html#midterm" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="2558" width="310" height="180" as="geometry" /></mxCell></object><object id="contributions" label="原创贡献整合、成果认定与学术交流&#10;&#10;串联各项研究，核对原创贡献与个人责任。" link="https://csma-graduation-projects.github.io/doctor.html#contributions" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2913" width="408" height="150" as="geometry" /></mxCell></object><object id="writing" label="学位论文统整与学术规范检查&#10;&#10;以证据组织论文，分别完成适用提交检查。" link="https://csma-graduation-projects.github.io/doctor.html#writing" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="3178" width="408" height="150" as="geometry" /></mxCell></object><object id="review" label="预答辩、送审与评阅意见处理&#10;&#10;按校本顺序完成预答辩、送审与意见处理。" link="https://csma-graduation-projects.github.io/doctor.html#review" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="3443" width="408" height="150" as="geometry" /></mxCell></object><object id="review-check" label="评阅处理完成并获答辩资格？&#10;&#10;依正式结论办理修改、复审或异议程序&#10;。" link="https://csma-graduation-projects.github.io/doctor.html#review" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="3708" width="408" height="240" as="geometry" /></mxCell></object><object id="review-revise" label="修订与复核&#10;&#10;逐项回应、补证与修订，按规定复审或延&#10;期。" link="https://csma-graduation-projects.github.io/templates.html#review-response" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="3708" width="310" height="180" as="geometry" /></mxCell></object><object id="defense" label="正式答辩、修改验收与学位申请&#10;&#10;取得资格后答辩，落实修改与正式学位手续。" link="https://csma-graduation-projects.github.io/doctor.html#defense" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="4063" width="408" height="150" as="geometry" /></mxCell></object><object id="defense-check" label="答辩后修改与提交已确认？&#10;&#10;学位授予状态另据学校正式决定记录。" link="https://csma-graduation-projects.github.io/doctor.html#defense" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="4328" width="408" height="240" as="geometry" /></mxCell></object><object id="defense-revise" label="修订与复核&#10;&#10;依据答辩结论修改并复核；需再次答辩时&#10;按规定办理。" link="https://csma-graduation-projects.github.io/templates.html#defense" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="4328" width="310" height="180" as="geometry" /></mxCell></object><object id="archive" label="研究资产归档、交接与后续发展&#10;&#10;验证资料可恢复、交接责任与后续研究线索。" link="https://csma-graduation-projects.github.io/doctor.html#archive" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="4683" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="qualification-check" target="qualification-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="返回补证与修订" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="qualification-revise" target="foundation"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="1182" /><mxPoint x="879" y="1182" /><mxPoint x="879" y="424" /><mxPoint x="42