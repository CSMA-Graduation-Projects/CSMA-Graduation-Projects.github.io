<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-competition-path" name="学科竞赛与创新实践流程图"><mxGraphModel dx="920" dy="2956" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2956" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="学科竞赛与创新实践流程图" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="主线覆盖全部 6 个阶段；判断节点给出继续条件，侧支路说明未满足时回到哪里。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：报名按官方窗口独立倒排，可与原型开发并行或按赛规调整先后，不等待内部流程而错过截止。每项受资格或审批限&#10;制的活动仍须满足正式条件。图示为工作导航，最终资格与成绩以官方结论为准。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="2846" width="840" height="50" as="geometry" /></mxCell><object id="selection" label="选赛、资格与规则核验&#10;&#10;核对赛道、资格、当届规则与官方期限。" link="https://csma-graduation-projects.github.io/competition.html#selection" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="selection-check" label="资格与规则确认？&#10;&#10;使用当届官方通知，不沿用往届推断。" link="https://csma-graduation-projects.github.io/competition.html#selection" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="240" as="geometry" /></mxCell></object><object id="selection-revise" label="修订与复核&#10;&#10;资格不符换赛道或停止；不明确事项先向&#10;官方核实再投入。" link="https://csma-graduation-projects.github.io/templates.html#competition" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="444" width="310" height="180" as="geometry" /></mxCell></object><object id="team" label="组队、选题与权属约定&#10;&#10;确认分工、作品范围与素材成果权属。" link="https://csma-graduation-projects.github.io/competition.html#team" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="799" width="408" height="150" as="geometry" /></mxCell></object><object id="prototype" label="方案原型、预算与报名&#10;&#10;报名窗口单列核对，原型与预算按赛程推进。" link="https://csma-graduation-projects.github.io/competition.html#prototype" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1064" width="408" height="150" as="geometry" /></mxCell></object><object id="prototype-check" label="当前投入条件和报名安排明确？&#10;&#10;满足当前活动的正式资格与预算条件；&#10;持续跟踪报名状态。" link="https://csma-graduation-projects.github.io/competition.html#prototype" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="240" as="geometry" /></mxCell></object><object id="prototype-revise" label="修订与复核&#10;&#10;调整方案、补正报名或缩减预算；无法解&#10;决时停止参赛并记录。" link="https://csma-graduation-projects.github.io/templates.html#competition" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1329" width="310" height="180" as="geometry" /></mxCell></object><object id="build" label="作品实现、复现与内部验收&#10;&#10;按评分项验收作品，核对版本与许可。" link="https://csma-graduation-projects.github.io/competition.html#build" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1684" width="408" height="150" as="geometry" /></mxCell></object><object id="build-check" label="作品符合提交条件？&#10;&#10;评分项、授权、功能和材料版本逐一对&#10;应。" link="https://csma-graduation-projects.github.io/competition.html#build" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1949" width="408" height="240" as="geometry" /></mxCell></object><object id="build-revise" label="修订与复核&#10;&#10;修复缺陷或删减不可靠功能，替换违规组&#10;件后重新验收。" link="https://csma-graduation-projects.github.io/templates.html#experiment" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1949" width="310" height="180" as="geometry" /></mxCell></object><object id="submission" label="正式提交、现场比赛与结果确认&#10;&#10;保存提交回执；获奖按官方公布结果登记。" link="https://csma-graduation-projects.github.io/competition.html#submission" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2304" width="408" height="150" as="geometry" /></mxCell></object><object id="archive" label="复盘、经费结算与成果归档&#10;&#10;完成复盘、经费设备结算和授权归档。" link="https://csma-graduation-projects.github.io/competition.html#archive" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2569" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="selection-check" target="selection-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="返回规则核验" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="selection-revise" target="selection"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="652" /><mxPoint x="879" y="652" /><mxPoint x="879" y="159" /><mxPoint x="422" y="159" /></Array></mxGeometry></mxCell><mxCell id="edge-2" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endAr