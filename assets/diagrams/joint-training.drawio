<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-joint-training" name="跨校联合培养流程图"><mxGraphModel dx="920" dy="3221" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="3221" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="跨校联合培养流程图" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="七个工作步骤连接接收或派出、共同指导、正式认定与交接；三处判断说明何时补充确认或返回整改。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：这是工作指南，不代表已批准的校际项目。导师同意、学校批准、研究完成和正式认定分别记录；按本人适用制度与&#10;有权部门结论办理，共同指导不自动产生联合或双学位。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="3111" width="840" height="50" as="geometry" /></mxCell><object id="scope" label="确认合作类型与角色&#10;&#10;明确接收或派出、学籍与授位单位及合作范围。" link="https://csma-graduation-projects.github.io/joint-training.html#types" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="requirements" label="核对要求与必要手续&#10;&#10;逐项确认接收、指导资格、阶段认定和办理部门。" link="https://csma-graduation-projects.github.io/joint-training.html#stages" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="150" as="geometry" /></mxCell></object><object id="entry-check" label="具备开始条件？&#10;&#10;必要批准、资源权限和接收安排均已有&#10;依据。" link="https://csma-graduation-projects.github.io/joint-training.html#stages" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="709" width="408" height="240" as="geometry" /></mxCell></object><object id="entry-revise" label="补齐手续和条件&#10;&#10;联系对应部门补充确认；相关条件未满足&#10;前不启动依赖它的工作。" link="https://csma-graduation-projects.github.io/joint-training.html#stages" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="709" width="310" height="180" as="geometry" /></mxCell></object><object id="plan" label="共同制订个人计划&#10;&#10;明确能力目标、任务、双方职责、截止日与检查证据。" link="https://csma-graduation-projects.github.io/joint-training.html#roles" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1064" width="408" height="150" as="geometry" /></mxCell></object><object id="execute" label="研究执行与联合反馈&#10;&#10;共用任务记录和材料版本，跟踪问题与反馈落实。" link="https://csma-graduation-projects.github.io/joint-training.html#coordination" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="150" as="geometry" /></mxCell></object><object id="review" label="阶段检查与材料准备&#10;&#10;学生自检，导师复核；按双方要求整理正式提交材料。" link="https://csma-graduation-projects.github.io/joint-training.html#stages" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1594" width="408" height="150" as="geometry" /></mxCell></object><object id="stage-check" label="交付和研究检查达到要求？&#10;&#10;证据支持约定结论，待处理意见和正式&#10;材料缺项已明确。" link="https://csma-graduation-projects.github.io/joint-training.html#stages" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1859" width="408" height="240" as="geometry" /></mxCell></object><object id="stage-revise" label="整改或调整计划&#10;&#10;写明缺口、负责人和复查日期；涉及正式&#10;节点的变化按规定办理。" link="https://csma-graduation-projects.github.io/joint-training.html#coordination" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1859" width="310" height="180" as="geometry" /></mxCell></object><object id="recognition" label="办理适用的正式认定&#10;&#10;向有权部门提交，分别保存回执、结论和下一步要求。" link="https://csma-graduation-projects.github.io/joint-training.html#stages" tooltip="工作步骤"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2214" width="408" height="150" as="geometry" /></mxCell></object><object id="recognition-check" label="认定状态已明确？&#10;&#10;适用事项有正式结论；无需认定的事项&#10;已有依据，未通过不记作通过。" link="https://csma-graduation-projects.github.io/joint-training.html#stages" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2479" width="408" height="240" as="geometry" /></mxCell></object><object id="recognition-revise" label="补件、复核或重新安排&#10;&#10;按反馈补充材料，或使用正式复核渠道；&#10;约定等待期间与后续安排。" link="https://csma-graduation-projects.github.io/joint-training.html#coordination" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="2479" width="310" height="180" as="geometry" /></mxCell></object><object id="handover" label="进入下一阶段或结束交接&#10;&#10;根据结论衔接后续培养，归档材料、确认留存与访问权限&#10;。" link="https://csma-graduation-projects.github.io/joint-training.html#closure" tooltip="完成与后续"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2834" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="scope" target="requirements"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="requirements" target="entry-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="满足后继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="entry-check" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="尚未具备" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="entry-check" target="entry-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="返回要求与手续核对" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="entry-revise" target="requirements"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="917" /><mxPoint x="894" y="917" /><mxPoint x="894" y="424" /><mxPoint x="422" y="424" /></Array></mxGeometry></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="plan" target="execute"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="execute" target="review"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="review" target="stage-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="满足后继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stage-check" target="recognition"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="需要整改" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stage-check" target="stage-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="返回计划与任务安排" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="stage-revise" target="plan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="2067" /><mxPoint x="874" y="2067" /><mxPoint x="874" y="1044" /><mxPoint x="422" y="1044" /></Array></mxGeometry></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="recognition" target="recognition-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-12" value="按结论衔接" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="recognition-check" target="handover"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-13" value="待补充或处理" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="recognition-check" target="recognition-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-14" value="返回认定办理" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="recognition-revise" target="recognition"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="2687" /><mxPoint x="894" y="2687" /><mxPoint x="894" y="2194" /><mxPoint x="422" y="2194" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
