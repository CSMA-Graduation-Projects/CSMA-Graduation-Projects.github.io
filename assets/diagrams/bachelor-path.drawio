<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-bachelor-path" name="本科毕业设计流程图"><mxGraphModel dx="920" dy="3486" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="3486" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="本科毕业设计流程图" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="主线覆盖全部 8 个阶段；判断节点给出继续条件，侧支路说明未满足时回到哪里。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：这是培养工作导航。学习、研究和写作可交叉推进；正式审批、成果认定与学位授予以本人适用制度和学校结论为准&#10;。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="3376" width="840" height="50" as="geometry" /></mxCell><object id="topic" label="核对要求、选题与任务书&#10;&#10;核对正式要求，确定范围和个人任务。" link="https://csma-graduation-projects.github.io/bachelor.html#topic" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="proposal" label="文献调研与开题&#10;&#10;形成综述、研究问题、方案与开题材料。" link="https://csma-graduation-projects.github.io/bachelor.html#proposal" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="150" as="geometry" /></mxCell></object><object id="proposal-check" label="正式开题满足要求？&#10;&#10;以学院正式结论和整改要求为准。" link="https://csma-graduation-projects.github.io/bachelor.html#proposal" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="709" width="408" height="240" as="geometry" /></mxCell></object><object id="proposal-revise" label="修订与复核&#10;&#10;按评审意见修改题目、路线或验证方案，&#10;依通知申请重审。" link="https://csma-graduation-projects.github.io/templates.html#review-response" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="709" width="310" height="180" as="geometry" /></mxCell></object><object id="design" label="需求分析与详细设计&#10;&#10;将核心需求对应到设计和验收方法。" link="https://csma-graduation-projects.github.io/bachelor.html#design" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1064" width="408" height="150" as="geometry" /></mxCell></object><object id="implementation" label="实现推进与中期检查&#10;&#10;完成核心功能，提交真实中期材料。" link="https://csma-graduation-projects.github.io/bachelor.html#implementation" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="150" as="geometry" /></mxCell></object><object id="implementation-check" label="中期条件已落实？&#10;&#10;核对核心实现、正式检查结论与待办。" link="https://csma-graduation-projects.github.io/bachelor.html#implementation" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1594" width="408" height="240" as="geometry" /></mxCell></object><object id="implementation-revise" label="修订与复核&#10;&#10;优先补齐核心路径，记录整改和复查；不&#10;能将计划当作已完成。" link="https://csma-graduation-projects.github.io/templates.html#change-request" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1594" width="310" height="180" as="geometry" /></mxCell></object><object id="validation" label="测试、实验与结果分析&#10;&#10;覆盖主要目标，保存失败和边界证据。" link="https://csma-graduation-projects.github.io/bachelor.html#validation" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1949" width="408" height="150" as="geometry" /></mxCell></object><object id="writing" label="论文撰写与规范检查&#10;&#10;完成论证、引用、格式与学校要求的检查。" link="https://csma-graduation-projects.github.io/bachelor.html#writing" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2214" width="408" height="150" as="geometry" /></mxCell></object><object id="defense" label="答辩准备、演示与回应&#10;&#10;核对资格与材料，准备可核查演示并正式答辩。" link="https://csma-graduation-projects.github.io/bachelor.html#defense" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2479" width="408" height="150" as="geometry" /></mxCell></object><object id="defense-check" label="正式答辩结论允许定稿？&#10;&#10;修改后通过等条件也须逐项落实。" link="https://csma-graduation-projects.github.io/bachelor.html#defense" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2744" width="408" height="240" as="geometry" /></mxCell></object><object id="defense-revise" label="修订与复核&#10;&#10;按学校规定修改、复查或再次申请；演示&#10;失败如实说明。" link="https://csma-graduation-projects.github.io/templates.html#review-response" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="2744" width="310" height="180" as="geometry" /></mxCell></object><object id="archive" label="修改定稿、归档与交接&#10;&#10;落实答辩意见、学校提交和研究资料交接。" link="https://csma-graduation-projects.github.io/bachelor.html#archive" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="3099" width="408" height="150" as="geometry" /></mxCell></object><mxCell id="edge-0" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="proposal-check" target="proposal-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="返回开题与重审" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="proposal-revise" target="proposal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="917" /><mxPoint x="879" y="917" /><mxPoint x="879" y="424" /><mxPoint x="422" y="424" /></Array></mxGeometry></mxCell><mxCell id="edge-2" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="implementation-check" target="implementation-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="返回设计与实现" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="implementation-revise" target="design"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="1802" /><mxPoint x="889" y="1802" /><mxPoint x="889" y="1044" /><mxPoint x="422" y="1044" /></Array></mxGeometry></mxCell><mxCell id="edge-4" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="defense-check" target="defense-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="返回论文整改与申请" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="defense-revise" target="writing"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="2952" /><mxPoint x="874" y="2952" /><mxPoint x="874" y="2194" /><mxPoint x="422" y="2194" /></Array></mxGeometry></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="topic" target="proposal"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="proposal" target="proposal-check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="满足后继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="proposal-check" target="design"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=0.5;exitY=1;entryX=0.