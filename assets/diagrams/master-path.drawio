<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="diagram-master-path" name="硕士培养与学位全流程图"><mxGraphModel dx="920" dy="5876" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="5876" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-title" value="硕士培养与学位全流程图" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="840" height="40" as="geometry" /></mxCell><mxCell id="diagram-summary" value="主线覆盖全部 13 个阶段；判断节点给出继续条件，侧支路说明未满足时回到哪里。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="63" width="840" height="30" as="geometry" /></mxCell><mxCell id="diagram-legend" value="向下推进；未满足走右侧整改支路；沿虚线返回对应步骤。点击节点打开在线说明。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="110" width="840" height="29" as="geometry" /></mxCell><mxCell id="diagram-note" value="使用边界：这是培养工作导航。学习、研究和写作可交叉推进；正式审批、成果认定与学位授予以本人适用制度和学校结论为准&#10;。 预答辩是否设置及与检测、送审的先后顺序，另按学校适用要求核对。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#14375f;" vertex="1" parent="1"><mxGeometry x="36" y="5766" width="840" height="50" as="geometry" /></mxCell><object id="orientation" label="入学、培养计划与日常管理约定&#10;&#10;入学核对培养与成果条件，约定沟通与复核。" link="https://csma-graduation-projects.github.io/master.html#orientation" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="179" width="408" height="150" as="geometry" /></mxCell></object><object id="topic" label="方向探索与研究选题&#10;&#10;用真实需求、初步验证与资源条件筛选问题。" link="https://csma-graduation-projects.github.io/master.html#topic" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="444" width="408" height="150" as="geometry" /></mxCell></object><object id="survey" label="文献综述与研究定位&#10;&#10;检索、精读、比较，说明与已有工作的关系。" link="https://csma-graduation-projects.github.io/master.html#survey" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="709" width="408" height="150" as="geometry" /></mxCell></object><object id="proposal" label="研究方案与正式开题&#10;&#10;问题、方法、评价与时间表一致，参加正式开题。" link="https://csma-graduation-projects.github.io/master.html#proposal" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1329" width="408" height="150" as="geometry" /></mxCell></object><object id="proposal-check" label="正式开题通过或整改完成？&#10;&#10;重审、重大变更按学校程序办理。" link="https://csma-graduation-projects.github.io/master.html#proposal" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="1594" width="408" height="240" as="geometry" /></mxCell></object><object id="proposal-revise" label="修订与复核&#10;&#10;处理评审意见；必要时缩题、改方法或申&#10;请重审，保留正式结论。" link="https://csma-graduation-projects.github.io/templates.html#review-response" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="1594" width="310" height="180" as="geometry" /></mxCell></object><object id="research" label="研究实施、专业实践与持续记录&#10;&#10;真实运行、实践与周报持续积累可复核证据。" link="https://csma-graduation-projects.github.io/master.html#research" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="1949" width="408" height="150" as="geometry" /></mxCell></object><object id="midterm" label="中期检查与年度考核&#10;&#10;按通知核对研究进展与全部必修环节。" link="https://csma-graduation-projects.github.io/master.html#midterm" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2214" width="408" height="150" as="geometry" /></mxCell></object><object id="midterm-check" label="考核满足且核心结论有证据？&#10;&#10;考核通过与研究完成分开判断；提纲、&#10;方法可并行写作。" link="https://csma-graduation-projects.github.io/master.html#midterm" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="2479" width="408" height="240" as="geometry" /></mxCell></object><object id="midterm-revise" label="修订与复核&#10;&#10;核心证据不足返回研究补证；正式考核未&#10;通过按程序整改，两种状态分别记录。" link="https://csma-graduation-projects.github.io/templates.html#annual-check" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="2479" width="310" height="180" as="geometry" /></mxCell></object><object id="writing" label="学位论文结构、初稿与反复修订&#10;&#10;从已有结果组织论证，保留导师反馈与修改。" link="https://csma-graduation-projects.github.io/master.html#writing" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="2834" width="408" height="150" as="geometry" /></mxCell></object><object id="outcomes" label="培养成果与学位申请条件核验&#10;&#10;最终复核入学已查明的申请条件与证明。" link="https://csma-graduation-projects.github.io/master.html#outcomes" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="3099" width="408" height="150" as="geometry" /></mxCell></object><object id="integrity" label="格式、查重、查非与 AI 使用说明&#10;&#10;区分引用查重、非学术性错误与 AI 使用说明。" link="https://csma-graduation-projects.github.io/master.html#integrity" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="3364" width="408" height="150" as="geometry" /></mxCell></object><object id="integrity-check" label="申请条件与检查均已确认？&#10;&#10;成果、查重、查非及 AI 要求分别核验&#10;。" link="https://csma-graduation-projects.github.io/master.html#integrity" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="3629" width="408" height="240" as="geometry" /></mxCell></object><object id="integrity-revise" label="修订与复核&#10;&#10;按具体原因补证据、修改、复检或调整申&#10;请时间；不自设阈值。" link="https://csma-graduation-projects.github.io/templates.html#integrity" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="3629" width="310" height="180" as="geometry" /></mxCell></object><object id="review" label="匿名送审、评阅意见与异议处理&#10;&#10;冻结对应版本，匿名送审并逐条处理意见。" link="https://csma-graduation-projects.github.io/master.html#review" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="3984" width="408" height="150" as="geometry" /></mxCell></object><object id="review-check" label="正式取得答辩资格？&#10;&#10;以评阅处理、复审或异议处理正式结论&#10;为准。" link="https://csma-graduation-projects.github.io/master.html#review" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="4249" width="408" height="240" as="geometry" /></mxCell></object><object id="review-revise" label="修订与复核&#10;&#10;逐条回复并按规定整改、复审或延期；不&#10;得私下影响评阅。" link="https://csma-graduation-projects.github.io/templates.html#review-response" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="4249" width="310" height="180" as="geometry" /></mxCell></object><object id="defense" label="答辩申请与正式答辩&#10;&#10;满足正式前置条件，申请并参加正式答辩。" link="https://csma-graduation-projects.github.io/master.html#defense" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="4604" width="408" height="150" as="geometry" /></mxCell></object><object id="defense-check" label="正式答辩结论允许办理后续？&#10;&#10;答辩通过仍不等于学位已授予。" link="https://csma-graduation-projects.github.io/master.html#defense" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="4869" width="408" height="240" as="geometry" /></mxCell></object><object id="defense-revise" label="修订与复核&#10;&#10;按正式结论修改或重新申请；时间安排遵&#10;循学校规定。" link="https://csma-graduation-projects.github.io/templates.html#review-response" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="4869" width="310" height="180" as="geometry" /></mxCell></object><object id="final" label="答辩后修改、定稿与学位手续&#10;&#10;完成修改确认、定稿提交与学校学位手续。" link="https://csma-graduation-projects.github.io/master.html#final" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="5224" width="408" height="150" as="geometry" /></mxCell></object><object id="archive" label="研究资料归档、交接与离组&#10;&#10;研究资料验收、权限与责任交接分别落实。" link="https://csma-graduation-projects.github.io/master.html#archive" tooltip="培养阶段"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#ffffff;strokeColor=#9db2b5;" vertex="1" parent="1"><mxGeometry x="36" y="5489" width="408" height="150" as="geometry" /></mxCell></object><object id="survey-check" label="定位与可行性仍成立？&#10;&#10;检查问题是否已被解决、必要数据能否&#10;获得。" link="https://csma-graduation-projects.github.io/master.html#survey" tooltip="条件判断"><mxCell style="rhombus;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#f6edda;strokeColor=#ad894a;fontSize=12;labelWidth=224;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="974" width="408" height="240" as="geometry" /></mxCell></object><object id="survey-revise" label="调整问题与补检索&#10;&#10;带比较矩阵回选题；新问题重新核对文献&#10;与资源。" link="https://csma-graduation-projects.github.io/templates.html#topic" tooltip="整改支路"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#243c4d;spacing=15;fillColor=#fffaf0;strokeColor=#baa371;" vertex="1" parent="1"><mxGeometry x="548" y="974" width="310" height="180" as="geometry" /></mxCell></object><mxCell id="edge-0" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="proposal-check" target="proposal-revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="返回选题与开题修订" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#a77931;dashed=1;fontColor=#805b28;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="proposal-revise" target="topic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="703.0" y="1802" /><mxPoint x="879" y="1802" /><mxPoint x="879" y="424" /><mxPoint x="422" y="424" /></Array></mxGeometry></mxCell><mxCell id="edge-2" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#f7f8f6;strokeColor=#426a71;fontColor=#24685f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent=